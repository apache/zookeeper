# ZooKeeper defaults to a 1000 MiB server heap and a 256 MiB client heap.
# Set either heap to a number to choose a different size in MiB.
# ZK_SERVER_HEAP=1000
# ZK_CLIENT_HEAP=256

# Set a heap to "omit" to suppress -Xmx and configure JVM memory sizing directly.
# ZK_SERVER_HEAP=omit
# SERVER_JVMFLAGS="-XX:InitialRAMPercentage=25 -XX:MaxRAMPercentage=75"
# ZK_CLIENT_HEAP=omit
# CLIENT_JVMFLAGS="-XX:MaxRAMPercentage=25"
