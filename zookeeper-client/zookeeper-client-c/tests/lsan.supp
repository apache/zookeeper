# LeakSanitizer suppressions for "make check" with --enable-asan.
#
# Suppressions must be restricted to third-party dependencies or C runtime leaks.

# glibc (>= 2.34) stores per-thread dlerror() state in thread-local storage
# unscanned by LeakSanitizer. Invoked during Cyrus SASL plugin loading via
# dlsym().
leak:_dlerror_run
