n-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#grafana","content":"Download and import the default ZooKeeper dashboard template\nand customize it to your needs. If you have improvements to share, send them to **dev\\@zookeeper.apache.org**."},"936":{"id":"/admin-ops/monitor-and-audit-logs-37","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#influxdb","content":"InfluxDB is an open source time series database often used to store ZooKeeper metrics.\nYou can download the open source version or\ncreate a free cloud account. In either case,\nconfigure the Apache ZooKeeper Telegraf plugin\nto collect and store metrics from your ZooKeeper clusters. There is also an\nApache ZooKeeper InfluxDB template\nthat includes Telegraf configuration and a pre-built dashboard to get you started quickly."},"937":{"id":"/admin-ops/monitor-and-audit-logs-38","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#jmx","content":"See the JMX guide for details."},"938":{"id":"/admin-ops/monitor-and-audit-logs-39","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#four-letter-words","content":"See the Four Letter Words section in the Administrator's Guide."},"939":{"id":"/admin-ops/monitor-and-audit-logs-40","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"Apache ZooKeeper supports audit logging from version 3.6.0. By default audit logs are disabled.\nTo enable them, set `audit.enable=true` in `conf/zoo.cfg`. Audit logs for client znode operations\nare written only on the servers to which a client is connected, as illustrated below."},"940":{"id":"/admin-ops/monitor-and-audit-logs-41","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"The audit log captures detailed information for audited operations, written as `key=value` pairs:"},"941":{"id":"/admin-ops/monitor-and-audit-logs-42","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"Key"},"942":{"id":"/admin-ops/monitor-and-audit-logs-43","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"Value"},"943":{"id":"/admin-ops/monitor-and-audit-logs-44","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"`session`"},"944":{"id":"/admin-ops/monitor-and-audit-logs-45","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"Client session ID."},"945":{"id":"/admin-ops/monitor-and-audit-logs-46","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"`user`"},"946":{"id":"/admin-ops/monitor-and-audit-logs-47","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"User associated with the operation. Client znode operations list all authenticated identities, separated by commas. See Who is taken as user in audit logs?"},"947":{"id":"/admin-ops/monitor-and-audit-logs-48","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"`ip`"},"948":{"id":"/admin-ops/monitor-and-audit-logs-49","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"Client IP address."},"949":{"id":"/admin-ops/monitor-and-audit-logs-50","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"`operation`"},"950":{"id":"/admin-ops/monitor-and-audit-logs-51","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"The audited operation. Possible values: `serverStart`, `serverStop`, `login`, `logout`, `ticketRenewal`, `create`, `delete`, `setData`, `setAcl`, `multiOperation`, `reconfig`, `ephemeralZNodeDeleteOnSessionClose`."},"951":{"id":"/admin-ops/monitor-and-audit-logs-52","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"`znode`"},"952":{"id":"/admin-ops/monitor-and-audit-logs-53","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"Path of the znode."},"953":{"id":"/admin-ops/monitor-and-audit-logs-54","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"`znode type`"},"954":{"id":"/admin-ops/monitor-and-audit-logs-55","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"Type of the znode (only for `create` operations)."},"955":{"id":"/admin-ops/monitor-and-audit-logs-56","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"`acl`"},"956":{"id":"/admin-ops/monitor-and-audit-logs-57","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"String representation of the znode ACL, e.g. `cdrwa` (create, delete, read, write, admin). Only logged for `setAcl`."},"957":{"id":"/admin-ops/monitor-and-audit-logs-58","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"`result`"},"958":{"id":"/admin-ops/monitor-and-audit-logs-59","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"Outcome of the operation: `success`, `failure`, or `invoked`. The `invoked` result is used for `serverStop` because the stop is logged before the server has confirmed it actually stopped."},"959":{"id":"/admin-ops/monitor-and-audit-logs-60","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"Sample audit logs for all operations, where the client connected from `192.168.1.2`, client\nprincipal is `zkcli@HADOOP.COM`, and server principal is `zookeeper/192.168.1.3@HADOOP.COM`:"},"960":{"id":"/admin-ops/monitor-and-audit-logs-61","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"**New in 3.10.0:** ZooKeeper also logs JAAS `login`, `logout`, and Kerberos `ticketRenewal`\nevents on clients and servers, including quorum members. These events describe the local\nprocess's JAAS credentials. They do not record incoming client or quorum learner SASL\nauthentication failures. For DIGEST-MD5, a successful JAAS login loads the credentials;\nSASL authentication happens later. Each event contains `user`, `operation`, and `result`,\nwithout a session ID, IP address, or znode path. To enable client audit logs, set\n`-Dzookeeper.audit.enable=true` and configure the audit logger in the client JVM."},"961":{"id":"/admin-ops/monitor-and-audit-logs-62","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"The `user` field uses the authenticated Kerberos principal or the DIGEST-MD5 username from the\nJAAS subject. If neither is available, ZooKeeper uses the first configured `principal` in the\nJAAS module chain (including the `other` fallback), then the configured `username`, then the\nOS user. Renewal failures keep the identity from the last successful login."},"962":{"id":"/admin-ops/monitor-and-audit-logs-63","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"Each failed cache refresh command or JAAS re-login records a `ticketRenewal` failure event.\nA successful re-login records `success`; skipped attempts produce no event. The `logout`\nevent also covers the logout performed during Kerberos re-login and does not indicate a client\ndisconnection. Stopping only the refresh thread does not log a logout."},"963":{"id":"/admin-ops/monitor-and-audit-logs-64","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"If the audit logger throws `RuntimeException` or `LinkageError` during a JAAS operation,\nZooKeeper writes the error to the regular log. These errors do not change the JAAS result.\nZooKeeper retains logger initialization failures and reports the original cause on subsequent\naudit calls and server startup. When recording a failed server start, these audit errors do not\nchange the server's exit code."},"964":{"id":"/admin-ops/monitor-and-audit-logs-65","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-logs","content":"Each JVM uses one audit logger. For a custom logger, set `zookeeper.audit.impl.class` to its fully\nqualified class name before the audit provider is first used. An audited client login can select\nthe logger before an embedded server reads its configuration. A later server configuration\nthat requests a different logger class fails; configuring the same class again is allowed."},"965":{"id":"/admin-ops/monitor-and-audit-logs-66","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-log-configuration","content":"Audit logging is performed using Logback. The following is the default logback configuration\nblock in `conf/logback.xml` (the entire block is commented out by default — uncomment it to\nactivate audit logging):"},"966":{"id":"/admin-ops/monitor-and-audit-logs-67","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#audit-log-configuration","content":"Modify this configuration to customize the audit log filename, number of backup files,\nmaximum file size, or to use a custom audit logger."},"967":{"id":"/admin-ops/monitor-and-audit-logs-68","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#who-is-taken-as-user-in-audit-logs","content":"There are four built-in authentication providers:"},"968":{"id":"/admin-ops/monitor-and-audit-logs-69","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#who-is-taken-as-user-in-audit-logs","content":"`IPAuthenticationProvider` — the authenticated IP address is used as the user."},"969":{"id":"/admin-ops/monitor-and-audit-logs-70","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#who-is-taken-as-user-in-audit-logs","content":"`SASLAuthenticationProvider` — the client principal is used as the user."},"970":{"id":"/admin-ops/monitor-and-audit-logs-71","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#who-is-taken-as-user-in-audit-logs","content":"`X509AuthenticationProvider` — the client certificate is used as the user."},"971":{"id":"/admin-ops/monitor-and-audit-logs-72","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#who-is-taken-as-user-in-audit-logs","content":"`DigestAuthenticationProvider` — the authenticated username is used as the user."},"972":{"id":"/admin-ops/monitor-and-audit-logs-73","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#who-is-taken-as-user-in-audit-logs","content":"Custom authentication providers can override `org.apache.zookeeper.server.auth.AuthenticationProvider.getUserName(String id)`\nto provide a user name. If a custom provider does not override this method, the value stored in\n`org.apache.zookeeper.data.Id.id` is used as the user. Generally only the user name is stored in\nthis field, but it is up to the custom provider what they store there."},"973":{"id":"/admin-ops/monitor-and-audit-logs-74","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#who-is-taken-as-user-in-audit-logs","content":"Not all ZooKeeper operations are initiated by clients — some are performed by the server itself.\nFor example, when a client session closes, any ephemeral znodes it owned are deleted by the server\ndirectly. These are called system operations. For system operations, the user associated with the\nZooKeeper server principal is logged as the user. For example, if the server principal is\n`zookeeper/hadoop.hadoop.com@HADOOP.COM`, it becomes the system user:"},"974":{"id":"/admin-ops/monitor-and-audit-logs-75","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#who-is-taken-as-user-in-audit-logs","content":"If there is no user associated with the ZooKeeper server, the OS user who started the server\nprocess is used. For example, if the server was started by `root`:"},"975":{"id":"/admin-ops/monitor-and-audit-logs-76","page_id":"/admin-ops/monitor-and-audit-logs","tags":[],"type":"text","url":"/admin-ops/monitor-and-audit-logs#who-is-taken-as-user-in-audit-logs","content":"A single client can attach multiple authentication schemes to a session. In that case all\nauthenticated identities are taken as the user and presented as a comma-separated list. For\nexample, if a client is authenticated with principal `zkcli@HADOOP.COM` and IP `127.0.0.1`,\nthe create operation audit log will be:"},"976":{"id":"/admin-ops/observers-guide","page_id":"/admin-ops/observers-guide","type":"page","content":"Observers","breadcrumbs":["Multi-Page Documentation","Admin & Ops"],"tags":[],"url":"/admin-ops/observers-guide"},"977":{"id":"/admin-ops/observers-guide-0","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide","content":"How ZooKeeper Observers enable scaling to large numbers of clients without hurting write performance, by using non-voting ensemble members that can be added freely without affecting quorum."},"978":{"id":"/admin-ops/observers-guide-1","page_id":"/admin-ops/observers-guide","type":"heading","tags":[],"url":"/admin-ops/observers-guide#how-to-use-observers","content":"How to Use Observers"},"979":{"id":"/admin-ops/observers-guide-2","page_id":"/admin-ops/observers-guide","type":"heading","tags":[],"url":"/admin-ops/observers-guide#how-to-use-observer-masters","content":"How to Use Observer Masters"},"980":{"id":"/admin-ops/observers-guide-3","page_id":"/admin-ops/observers-guide","type":"heading","tags":[],"url":"/admin-ops/observers-guide#example-use-cases","content":"Example Use Cases"},"981":{"id":"/admin-ops/observers-guide-4","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide","content":"Although ZooKeeper performs very well by having clients connect directly\nto voting members of the ensemble, this architecture makes it hard to\nscale out to huge numbers of clients. The problem is that as we add more\nvoting members, write performance drops. This is because a write operation\nrequires the agreement of at least half the nodes in an ensemble, so the\ncost of a vote grows significantly as more voters are added."},"982":{"id":"/admin-ops/observers-guide-5","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide","content":"We have introduced a new type of ZooKeeper node called an *Observer* which\nhelps address this problem and further improves ZooKeeper's scalability. Observers\nare non-voting members of an ensemble which only hear the results of votes, not the\nagreement protocol that leads up to them. Other than this simple distinction,\nObservers function exactly the same as Followers — clients may connect to\nthem and send read and write requests to them. Observers forward these\nrequests to the Leader like Followers do, but they then simply wait to\nhear the result of the vote. Because of this, we can increase the number\nof Observers as much as we like without harming vote performance."},"983":{"id":"/admin-ops/observers-guide-6","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide","content":"Observers have other advantages. Because they do not vote, they are not a\ncritical part of the ZooKeeper ensemble — they can fail or be\ndisconnected from the cluster without harming the availability of the\nZooKeeper service. The benefit to the user is that Observers may connect\nover less reliable network links than Followers. In fact, Observers may be\nused to talk to a ZooKeeper server from another data center. Clients of\nan Observer will see fast reads, as all reads are served locally, and\nwrites result in minimal network traffic since the number of messages\nrequired without the vote protocol is smaller."},"984":{"id":"/admin-ops/observers-guide-7","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide#how-to-use-observers","content":"Setting up a ZooKeeper ensemble that uses Observers requires just two\nchanges to your config files."},"985":{"id":"/admin-ops/observers-guide-8","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide#how-to-use-observers","content":"First, in the config file of every node that is to be an Observer, add:"},"986":{"id":"/admin-ops/observers-guide-9","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide#how-to-use-observers","content":"This tells ZooKeeper that the server is to be an Observer."},"987":{"id":"/admin-ops/observers-guide-10","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide#how-to-use-observers","content":"Second, in every server config file, append `:observer` to the server\ndefinition line of each Observer. For example:"},"988":{"id":"/admin-ops/observers-guide-11","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide#how-to-use-observers","content":"This tells every other server that `server.1` is an Observer and that they\nshould not expect it to vote. This is all the configuration needed to add\nan Observer to your ZooKeeper cluster. You can then connect to it as you\nwould an ordinary Follower:"},"989":{"id":"/admin-ops/observers-guide-12","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide#how-to-use-observers","content":"where `localhost:2181` is the hostname and port of the Observer as\nspecified in every config file. You should see a command line prompt\nthrough which you can issue commands like `ls` to query the ZooKeeper service."},"990":{"id":"/admin-ops/observers-guide-13","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide#how-to-use-observer-masters","content":"Observers function simply as non-voting members of the ensemble, sharing\nthe Learner interface with Followers and holding only a slightly different\ninternal pipeline. Both maintain connections along the quorum port with the\nLeader by which they learn of all new proposals on the ensemble."},"991":{"id":"/admin-ops/observers-guide-14","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide#how-to-use-observer-masters","content":"By default, Observers connect to the Leader along its quorum port to learn of\nnew proposals. There are benefits to allowing Observers to connect to\nFollowers instead as a means of plugging into the commit stream. This shifts\nthe burden of supporting Observers off the Leader, allowing it to focus on\ncoordinating the commit of writes. The result is better performance when the\nLeader is under high load — particularly high network load such as after a\nleader election when many Learners need to sync. It also reduces the total\nnumber of network connections maintained on the Leader when there are many\nObservers. Activating this feature allows the overall number of Observers to\nscale into the hundreds, and improves Observer availability since a large\nnumber of Observers finish syncing and start serving client traffic faster."},"992":{"id":"/admin-ops/observers-guide-15","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide#how-to-use-observer-masters","content":"This feature is activated by adding the following entry to the server config\nfile. It instructs Observers to connect to peers (Leaders and Followers) on\nthe specified port, and instructs Followers to create an ObserverMaster thread\nto listen and serve on that port:"},"993":{"id":"/admin-ops/observers-guide-16","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide#example-use-cases","content":"Wherever you wish to scale the number of clients of your ZooKeeper ensemble,\nor where you wish to insulate the critical part of an ensemble from the load\nof dealing with client requests, Observers are a good architectural choice.\nTwo example use cases are:"},"994":{"id":"/admin-ops/observers-guide-17","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide#example-use-cases","content":"**Datacenter bridge:** Forming a ZooKeeper ensemble between two datacenters is\nproblematic because high variance in latency between datacenters can lead to\nfalse-positive failure detection and partitioning. However, if the ensemble runs\nentirely in one datacenter and the second datacenter runs only Observers,\npartitions are not problematic — the ensemble remains connected. Clients of the\nObservers may still see and issue proposals."},"995":{"id":"/admin-ops/observers-guide-18","page_id":"/admin-ops/observers-guide","tags":[],"type":"text","url":"/admin-ops/observers-guide#example-use-cases","content":"**Message bus integration:** Some use cases call for ZooKeeper as a component of\na persistent reliable message bus. Observers provide a natural integration point:\na plug-in mechanism can attach the stream of proposals an Observer sees to a\npublish-subscribe system, without loading the core ensemble."},"996":{"id":"/admin-ops/quorums","page_id":"/admin-ops/quorums","type":"page","content":"Quorums","breadcrumbs":["Multi-Page Documentation","Admin & Ops"],"tags":[],"url":"/admin-ops/quorums"},"997":{"id":"/admin-ops/quorums-0","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums","content":"How to configure ZooKeeper quorums: hierarchical quorums using server groups and weights, and Oracle Quorum for increasing availability in two-instance clusters."},"998":{"id":"/admin-ops/quorums-1","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#hierarchical-quorums","content":"Hierarchical Quorums"},"999":{"id":"/admin-ops/quorums-2","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#oracle-quorum","content":"Oracle Quorum"},"1000":{"id":"/admin-ops/quorums-3","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#the-implementation-of-the-oracle","content":"The Implementation of the Oracle"},"1001":{"id":"/admin-ops/quorums-4","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#deployment-contexts","content":"Deployment Contexts"},"1002":{"id":"/admin-ops/quorums-5","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#configuring-the-oracle-in-zoocfg","content":"Configuring the Oracle in `zoo.cfg`"},"1003":{"id":"/admin-ops/quorums-6","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#example-zoocfg","content":"Example `zoo.cfg`"},"1004":{"id":"/admin-ops/quorums-7","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#behavior-after-enabling-the-oracle","content":"Behavior After Enabling the Oracle"},"1005":{"id":"/admin-ops/quorums-8","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#considerations-when-using-the-oracle","content":"Considerations When Using the Oracle"},"1006":{"id":"/admin-ops/quorums-9","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#liveness-issue","content":"Liveness Issue"},"1007":{"id":"/admin-ops/quorums-10","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#safety-issue","content":"Safety Issue"},"1008":{"id":"/admin-ops/quorums-11","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#examples-of-failure-detector-implementations","content":"Examples of Failure Detector Implementations"},"1009":{"id":"/admin-ops/quorums-12","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#hardware-based-implementation","content":"Hardware-based Implementation"},"1010":{"id":"/admin-ops/quorums-13","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#software-based-implementation","content":"Software-based Implementation"},"1011":{"id":"/admin-ops/quorums-14","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"Using a USB Device as the Oracle"},"1012":{"id":"/admin-ops/quorums-15","page_id":"/admin-ops/quorums","type":"heading","tags":[],"url":"/admin-ops/quorums#reference","content":"Reference"},"1013":{"id":"/admin-ops/quorums-16","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#hierarchical-quorums","content":"This document gives an example of how to use hierarchical quorums. The basic idea is\nvery simple. First, we split servers into groups, and add a line for each group listing\nthe servers that form this group. Next we have to assign a weight to each server."},"1014":{"id":"/admin-ops/quorums-17","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#hierarchical-quorums","content":"The following example shows how to configure a system with three groups of three servers\neach, and we assign a weight of 1 to each server:"},"1015":{"id":"/admin-ops/quorums-18","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#hierarchical-quorums","content":"When running the system, we are able to form a quorum once we have a majority of votes from\na majority of non-zero-weight groups. Groups that have zero weight are discarded and not\nconsidered when forming quorums. Looking at the example, we are able to form a quorum once\nwe have votes from at least two servers from each of two different groups."},"1016":{"id":"/admin-ops/quorums-19","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#oracle-quorum","content":"Oracle Quorum increases the availability of a cluster of 2 ZooKeeper instances with a failure detector known as the Oracle.\nThe Oracle is designed to grant permission to the instance which is the only remaining instance\nin a 2-instance configuration when the other instance is identified as faulty by the failure detector."},"1017":{"id":"/admin-ops/quorums-20","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#the-implementation-of-the-oracle","content":"Every instance accesses a file which contains either `0` or `1` to indicate whether that instance is authorized by the Oracle.\nThis design can be changed since failure detector algorithms vary. You can override the `askOracle()` method in *QuorumOracleMaj* to adapt a preferred way of reading the Oracle's decision."},"1018":{"id":"/admin-ops/quorums-21","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#deployment-contexts","content":"The Oracle is designed to increase the availability of a cluster of **2** ZooKeeper instances; thus, the size of the voting member is **2**.\nIn other words, the Oracle solves the consensus problem of a possible faulty instance in a two-instance ensemble."},"1019":{"id":"/admin-ops/quorums-22","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#deployment-contexts","content":"When the size of the voting members exceeds 2, the expected way to make the Oracle work correctly is to reconfigure the cluster size when a faulty machine is identified.\nFor example, with a configuration of 5 instances, when a faulty machine breaks the connection with the Leader, a *reconfig* client request is expected to re-form the cluster as 4 instances.\nOnce the size of the voting member equals 2, the configuration falls into the problem domain which the Oracle is designed to address."},"1020":{"id":"/admin-ops/quorums-23","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#configuring-the-oracle-in-zoocfg","content":"Regardless of the cluster size, `oraclePath` must be configured at initialization time, like other static parameters.\nThe following shows the correct way to specify and enable the Oracle:"},"1021":{"id":"/admin-ops/quorums-24","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#configuring-the-oracle-in-zoocfg","content":"`QuorumOracleMaj` reads the result of a failure detector written to a text file — the oracle file.\nSuppose you have the result of the failure detector written to `/some/path/result.txt`; the correct configuration is:"},"1022":{"id":"/admin-ops/quorums-25","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#configuring-the-oracle-in-zoocfg","content":"The oracle file should contain `1` to authorize the instance, or `0` to deny it. An example file can be created with:"},"1023":{"id":"/admin-ops/quorums-26","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#configuring-the-oracle-in-zoocfg","content":"Any equivalent file is suitable for the current implementation of `QuorumOracleMaj`.\nThe number of oracle files should equal the number of ZooKeeper instances configured to enable the Oracle.\nEach ZooKeeper instance should have its own oracle file — files must not be shared, otherwise the issues described in the Safety section will arise."},"1024":{"id":"/admin-ops/quorums-27","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#behavior-after-enabling-the-oracle","content":"*QuorumPeerConfig* will create an instance of *QuorumOracleMaj* instead of the default `QuorumMaj` when it reads an `oraclePath` in `zoo.cfg`.\n`QuorumOracleMaj` inherits from `QuorumMaj` and differs from its superclass by overriding `containsQuorum()`.\n`QuorumOracleMaj` executes its version of `containsQuorum` when the Leader loses all of its followers and fails to maintain the quorum.\nIn all other cases, *QuorumOracleMaj* behaves identically to *QuorumMaj*."},"1025":{"id":"/admin-ops/quorums-28","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#considerations-when-using-the-oracle","content":"We consider an asynchronous distributed system which consists of **2** ZooKeeper instances and an Oracle."},"1026":{"id":"/admin-ops/quorums-29","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#liveness-issue","content":"When the Oracle satisfies the following property introduced by [^1]:"},"1027":{"id":"/admin-ops/quorums-30","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#liveness-issue","content":"> **Strong Completeness:** There is a time after which every process that crashes is permanently suspected by every correct process."},"1028":{"id":"/admin-ops/quorums-31","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#liveness-issue","content":"Liveness of the system is ensured by the Oracle.\nHowever, when the Oracle fails to maintain this property, loss of liveness is expected. For example:"},"1029":{"id":"/admin-ops/quorums-32","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#liveness-issue","content":"Suppose we have a Leader and a Follower running in the broadcasting state. The system will lose its liveness when:"},"1030":{"id":"/admin-ops/quorums-33","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#liveness-issue","content":"The Leader fails, but the Oracle does not detect the faulty Leader — the Oracle will not authorize the Follower to become a new Leader."},"1031":{"id":"/admin-ops/quorums-34","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#liveness-issue","content":"A Follower fails, but the Oracle does not detect the faulty Follower — the Oracle will authorize the Leader to move the system forward."},"1032":{"id":"/admin-ops/quorums-35","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"**Loss of Progress**"},"1033":{"id":"/admin-ops/quorums-36","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"Progress can be lost when multiple failures occur in the system at different times. For example:"},"1034":{"id":"/admin-ops/quorums-37","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"Suppose we have a Leader (Ben) and a Follower (John) in the broadcasting state:"},"1035":{"id":"/admin-ops/quorums-38","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"**T1** `zxid(0x1_1)`: L-Ben fails, and F-John takes over under authorization from the Oracle."},"1036":{"id":"/admin-ops/quorums-39","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"**T2** `zxid(0x2_1)`: F-John becomes a new Leader (L-John) and starts a new epoch."},"1037":{"id":"/admin-ops/quorums-40","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"**T3** `zxid(0x2_A)`: L-John fails."},"1038":{"id":"/admin-ops/quorums-41","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"**T4** `zxid(0x2_A)`: Ben recovers and starts leader election."},"1039":{"id":"/admin-ops/quorums-42","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"**T5** `zxid(0x3_1)`: Ben becomes the new Leader (L-Ben) under authorization from the Oracle."},"1040":{"id":"/admin-ops/quorums-43","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"In this case, the system loses its progress after L-Ben initially failed."},"1041":{"id":"/admin-ops/quorums-44","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"However, loss of progress can be prevented by making the Oracle capable of referring to the latest zxid.\nWhen the Oracle can refer to the latest zxid, at T5 `zxid(0x2_A)`, Ben will not complete leader election because the Oracle would not authorize him while John is still known to be ahead.\nThis trades liveness for safety."},"1042":{"id":"/admin-ops/quorums-45","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"**Split Brain Issue**"},"1043":{"id":"/admin-ops/quorums-46","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"We consider the Oracle satisfies the following property introduced by [^1]:"},"1044":{"id":"/admin-ops/quorums-47","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"> **Accuracy:** There is a time after which some correct process is never suspected by any process."},"1045":{"id":"/admin-ops/quorums-48","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"The decisions the Oracle gives out must be mutually exclusive."},"1046":{"id":"/admin-ops/quorums-49","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"Suppose we have a Leader (Ben) and a Follower (John) in the broadcasting state:"},"1047":{"id":"/admin-ops/quorums-50","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"At any time, the Oracle will not authorize both Ben and John simultaneously, even if each failure detector suspects the other."},"1048":{"id":"/admin-ops/quorums-51","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"Equivalently: for any two Oracle files, their values must not both be `1` at the same time."},"1049":{"id":"/admin-ops/quorums-52","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"Split brain is expected when the Oracle fails to maintain this property during leader election, which can happen at:"},"1050":{"id":"/admin-ops/quorums-53","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"System start."},"1051":{"id":"/admin-ops/quorums-54","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#safety-issue","content":"A failed instance recovering from failure."},"1052":{"id":"/admin-ops/quorums-55","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#examples-of-failure-detector-implementations","content":"A failure detector's role is to authorize the querying ZooKeeper instance whether it has the right to move the system forward without waiting for the faulty instance."},"1053":{"id":"/admin-ops/quorums-56","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#hardware-based-implementation","content":"Suppose two dedicated hardware nodes, `hw1` and `hw2`, host ZooKeeper instances `zk1` and `zk2` respectively, forming a cluster.\nA hardware device attached to both nodes can determine whether each is powered on.\nWhen `hw1` is not powered on, `zk1` is undoubtedly faulty.\nThe hardware device then updates the oracle file on `hw2` to `1`, authorizing `zk2` to move the system forward."},"1054":{"id":"/admin-ops/quorums-57","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#software-based-implementation","content":"Suppose two dedicated hardware nodes, `hw1` and `hw2`, host ZooKeeper instances `zk1` and `zk2` respectively.\nTwo services, `o1` on `hw1` and `o2` on `hw2`, detect whether the other node is alive (for example, by pinging).\nWhen `o1` cannot ping `hw2`, it identifies `hw2` as faulty and updates the oracle file of `zk1` to `1`, authorizing `zk1` to move forward."},"1055":{"id":"/admin-ops/quorums-58","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"In macOS 10.15.7 (19H2), external storage devices are mounted under `/Volumes`.\nA USB device containing the required oracle file can serve as the Oracle.\nWhen the device is connected, the oracle authorizes the leader to move the system forward."},"1056":{"id":"/admin-ops/quorums-59","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"The following 6 steps demonstrate how this works:"},"1057":{"id":"/admin-ops/quorums-60","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"Insert a USB device named `Oracle`. The path `/Volumes/Oracle` will be accessible."},"1058":{"id":"/admin-ops/quorums-61","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"Create a file containing `1` under `/Volumes/Oracle` named `mastership`:"},"1059":{"id":"/admin-ops/quorums-62","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"The path `/Volumes/Oracle/mastership` is now accessible to ZooKeeper instances."},"1060":{"id":"/admin-ops/quorums-63","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"Create a `zoo.cfg` like the following:"},"1061":{"id":"/admin-ops/quorums-64","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"> **Note:** Split brain will not occur here because there is only a single USB device. `mastership` must not be shared by multiple instances — only one ZooKeeper instance should be configured with Oracle. See the Safety Issue section for details."},"1062":{"id":"/admin-ops/quorums-65","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"Start the cluster. It should form a quorum normally."},"1063":{"id":"/admin-ops/quorums-66","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"Terminate the instance that is either not attached to a USB device or whose `mastership` file contains `0`. Two scenarios are expected:"},"1064":{"id":"/admin-ops/quorums-67","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"A leader failure occurs, and the remaining instance completes leader election on its own via the Oracle."},"1065":{"id":"/admin-ops/quorums-68","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"The quorum is maintained via the Oracle."},"1066":{"id":"/admin-ops/quorums-69","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"Remove the USB device. `/Volumes/Oracle/mastership` becomes unavailable. According to the current implementation, whenever the Leader queries the oracle and the file is missing, the oracle throws an exception and returns `false`. Repeating step 5 will result in either the system being unable to recover from a leader failure, or the leader losing the quorum and service being interrupted."},"1067":{"id":"/admin-ops/quorums-70","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#using-a-usb-device-as-the-oracle","content":"With these steps, you can observe and practice how the Oracle works with a two-instance system."},"1068":{"id":"/admin-ops/quorums-71","page_id":"/admin-ops/quorums","tags":[],"type":"text","url":"/admin-ops/quorums#reference","content":"Tushar Deepak Chandra and Sam Toueg. 1991. Unreliable failure detectors for asynchronous systems (preliminary version). In *Proceedings of the tenth annual ACM symposium on Principles of distributed computing* (*PODC '91*). Association for Computing Machinery, New York, NY, USA, 325–340. DOI:10.1145/112600.112627"},"1069":{"id":"/admin-ops/quota-guide","page_id":"/admin-ops/quota-guide","type":"page","content":"Quota Guide","breadcrumbs":["Multi-Page Documentation","Admin & Ops"],"tags":[],"url":"/admin-ops/quota-guide"},"1070":{"id":"/admin-ops/quota-guide-0","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide","content":"ZooKeeper has both namespace and bytes quotas. You can use the ZooKeeperMain class to setup quotas."},"1071":{"id":"/admin-ops/quota-guide-1","page_id":"/admin-ops/quota-guide","type":"heading","tags":[],"url":"/admin-ops/quota-guide#setting-quotas","content":"Setting Quotas"},"1072":{"id":"/admin-ops/quota-guide-2","page_id":"/admin-ops/quota-guide","type":"heading","tags":[],"url":"/admin-ops/quota-guide#listing-quotas","content":"Listing Quotas"},"1073":{"id":"/admin-ops/quota-guide-3","page_id":"/admin-ops/quota-guide","type":"heading","tags":[],"url":"/admin-ops/quota-guide#deleting-quotas","content":"Deleting Quotas"},"1074":{"id":"/admin-ops/quota-guide-4","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide","content":"ZooKeeper prints *WARN* messages if users exceed the quota assigned to them. The messages\nare printed in the log of the ZooKeeper."},"1075":{"id":"/admin-ops/quota-guide-5","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide","content":"Notice: What the `namespace` quota means is the count quota which limits the number of children\nunder the path (included itself)."},"1076":{"id":"/admin-ops/quota-guide-6","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide","content":"The above command gives you a command line option of using quotas."},"1077":{"id":"/admin-ops/quota-guide-7","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide#setting-quotas","content":"You can use `setquota` to set a quota on a ZooKeeper node. It has an option of setting quota with\n`-n` (for namespace/count) and `-b` (for bytes/data length)."},"1078":{"id":"/admin-ops/quota-guide-8","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide#setting-quotas","content":"The ZooKeeper quota is stored in ZooKeeper itself in **/zookeeper/quota*&#x2A;. To disable other people from\nchanging the quotas, users can set the ACL for **/zookeeper/quota** so that only admins are able to read and write to it."},"1079":{"id":"/admin-ops/quota-guide-9","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide#setting-quotas","content":"If the quota doesn't exist in the specified path, create the quota, otherwise update the quota."},"1080":{"id":"/admin-ops/quota-guide-10","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide#setting-quotas","content":"The scope of the quota users set is all the nodes under the path specified (included itself)."},"1081":{"id":"/admin-ops/quota-guide-11","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide#setting-quotas","content":"In order to simplify the calculation of quota in the current directory/hierarchy structure, a complete\ntree path (from root to leaf node) can be set only one quota. In the situation when setting a quota in\na path which its parent or child node already has a quota, `setquota` will reject and tell the specified\nparent or child path. Users can adjust allocations of quotas (delete/move-up/move-down the quota)\naccording to specific circumstances."},"1082":{"id":"/admin-ops/quota-guide-12","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide#setting-quotas","content":"Combined with the Chroot, the quota will have a better isolation effectiveness between different\napplications. For example:"},"1083":{"id":"/admin-ops/quota-guide-13","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide#setting-quotas","content":"Users cannot set the quota on the path under **/zookeeper/quota**."},"1084":{"id":"/admin-ops/quota-guide-14","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide#setting-quotas","content":"The quota supports soft and hard quotas. The soft quota just logs a warning when exceeding the quota,\nbut the hard quota also throws a `QuotaExceededException`. When setting soft and hard quota on the same\npath, the hard quota has priority."},"1085":{"id":"/admin-ops/quota-guide-15","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide#listing-quotas","content":"You can use *listquota* to list a quota on a ZooKeeper node."},"1086":{"id":"/admin-ops/quota-guide-16","page_id":"/admin-ops/quota-guide","tags":[],"type":"text","url":"/admin-ops/quota-guide#deleting-quotas","content":"You can use *delquota* to delete quota on a ZooKeeper node."},"1087":{"id":"/admin-ops/snapshot-and-restore-guide","page_id":"/admin-ops/snapshot-and-restore-guide","type":"page","content":"Snapshot and Restore Guide","breadcrumbs":["Multi-Page Documentation","Admin & Ops"],"tags":[],"url":"/admin-ops/snapshot-and-restore-guide"},"1088":{"id":"/admin-ops/snapshot-and-restore-guide-0","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide","content":"How to use ZooKeeper's snapshot and restore APIs to recover a cluster from quorum loss or catastrophic failure."},"1089":{"id":"/admin-ops/snapshot-and-restore-guide-1","page_id":"/admin-ops/snapshot-and-restore-guide","type":"heading","tags":[],"url":"/admin-ops/snapshot-and-restore-guide#snapshot","content":"Snapshot"},"1090":{"id":"/admin-ops/snapshot-and-restore-guide-2","page_id":"/admin-ops/snapshot-and-restore-guide","type":"heading","tags":[],"url":"/admin-ops/snapshot-and-restore-guide#restore","content":"Restore"},"1091":{"id":"/admin-ops/snapshot-and-restore-guide-3","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide","content":"ZooKeeper is designed to withstand machine failures. A ZooKeeper cluster can automatically recover\nfrom temporary failures such as machine reboots, and can tolerate up to (N-1)/2 permanent failures\nfor a cluster of N members due to hardware failures or disk corruption. When a member permanently\nfails, it loses access to the cluster. If the cluster permanently loses more than (N-1)/2 members,\nit disastrously fails and loses quorum. Once quorum is lost, the cluster cannot reach consensus and\ntherefore cannot continue to accept updates."},"1092":{"id":"/admin-ops/snapshot-and-restore-guide-4","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide","content":"To recover from such disastrous failures, ZooKeeper provides snapshot and restore functionalities to\nrestore a cluster from a snapshot."},"1093":{"id":"/admin-ops/snapshot-and-restore-guide-5","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide","content":"Key characteristics of snapshot and restore:"},"1094":{"id":"/admin-ops/snapshot-and-restore-guide-6","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide","content":"They operate on the connected server via Admin Server APIs."},"1095":{"id":"/admin-ops/snapshot-and-restore-guide-7","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide","content":"They are rate-limited to protect the server from being overloaded."},"1096":{"id":"/admin-ops/snapshot-and-restore-guide-8","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide","content":"They require authentication and authorization on the root path with ALL permission. The supported\nauth schemes are digest, x509, and IP."},"1097":{"id":"/admin-ops/snapshot-and-restore-guide-9","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide#snapshot","content":"Recovering a cluster needs a snapshot from a ZooKeeper cluster. Users can periodically take\nsnapshots from a live server which has the highest zxid and stream out data to local or external\nstorage/file system (e.g., S3)."},"1098":{"id":"/admin-ops/snapshot-and-restore-guide-10","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide#restore","content":"Restoring a cluster needs a single snapshot as input stream. Restore can be used for recovering a\ncluster after quorum loss or for building a brand-new cluster with seed data."},"1099":{"id":"/admin-ops/snapshot-and-restore-guide-11","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide#restore","content":"All members should restore using the same snapshot. The recommended steps are:"},"1100":{"id":"/admin-ops/snapshot-and-restore-guide-12","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide#restore","content":"Take a snapshot of the latest database state using the snapshot admin server command, if\napplicable."},"1101":{"id":"/admin-ops/snapshot-and-restore-guide-13","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide#restore","content":"For each server:"},"1102":{"id":"/admin-ops/snapshot-and-restore-guide-14","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide#restore","content":"Move the files in `dataDir` and `dataLogDir` to a different location to prevent the restored\ndatabase from being overwritten when the server restarts after restore."},"1103":{"id":"/admin-ops/snapshot-and-restore-guide-15","page_id":"/admin-ops/snapshot-and-restore-guide","tags":[],"type":"text","url":"/admin-ops/snapshot-and-restore-guide#restore","content":"Restore the server using the restore admin server command:"},"1104":{"id":"/admin-ops/tools","page_id":"/admin-ops/tools","type":"page","content":"Tools","breadcrumbs":["Multi-Page Documentation","Admin & Ops"],"tags":[],"url":"/admin-ops/tools"},"1105":{"id":"/admin-ops/tools-0","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools","content":"Reference for the scripts and tools bundled with ZooKeeper — including server management scripts, snapshot and transaction log utilities, benchmark tools, and testing frameworks."},"1106":{"id":"/admin-ops/tools-1","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#scripts","content":"Scripts"},"1107":{"id":"/admin-ops/tools-2","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#zkserversh","content":"zkServer.sh"},"1108":{"id":"/admin-ops/tools-3","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#zkclish","content":"zkCli.sh"},"1109":{"id":"/admin-ops/tools-4","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#zkenvsh","content":"zkEnv.sh"},"1110":{"id":"/admin-ops/tools-5","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#zkcleanupsh","content":"zkCleanup.sh"},"1111":{"id":"/admin-ops/tools-6","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#zktxnlogtoolkitsh","content":"zkTxnLogToolkit.sh"},"1112":{"id":"/admin-ops/tools-7","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#zksnapshottoolkitsh","content":"zkSnapShotToolkit.sh"},"1113":{"id":"/admin-ops/tools-8","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#zksnapshotrecursivesummarytoolkitsh","content":"zkSnapshotRecursiveSummaryToolkit.sh"},"1114":{"id":"/admin-ops/tools-9","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#zksnapshotcomparersh","content":"zkSnapshotComparer.sh"},"1115":{"id":"/admin-ops/tools-10","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#locating-snapshots","content":"Locating Snapshots"},"1116":{"id":"/admin-ops/tools-11","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#supported-snapshot-formats","content":"Supported Snapshot Formats"},"1117":{"id":"/admin-ops/tools-12","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#running-the-tool","content":"Running the Tool"},"1118":{"id":"/admin-ops/tools-13","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#interactive-mode","content":"Interactive Mode"},"1119":{"id":"/admin-ops/tools-14","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#benchmark","content":"Benchmark"},"1120":{"id":"/admin-ops/tools-15","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#ycsb","content":"YCSB"},"1121":{"id":"/admin-ops/tools-16","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#zk-smoketest","content":"zk-smoketest"},"1122":{"id":"/admin-ops/tools-17","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#testing","content":"Testing"},"1123":{"id":"/admin-ops/tools-18","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#fault-injection-framework","content":"Fault Injection Framework"},"1124":{"id":"/admin-ops/tools-19","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#byteman","content":"Byteman"},"1125":{"id":"/admin-ops/tools-20","page_id":"/admin-ops/tools","type":"heading","tags":[],"url":"/admin-ops/tools#jepsen-test","content":"Jepsen Test"},"1126":{"id":"/admin-ops/tools-21","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkserversh","content":"Manage the ZooKeeper server process."},"1127":{"id":"/admin-ops/tools-22","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkserversh","content":"The `status` command establishes a client connection to execute diagnostic commands.\nWhen the ZooKeeper cluster is started in TLS-only mode (by omitting `clientPort` from\n`zoo.cfg`), additional SSL configuration must be provided:"},"1128":{"id":"/admin-ops/tools-23","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkclish","content":"See ZooKeeper CLI."},"1129":{"id":"/admin-ops/tools-24","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"Sets environment variables for ZooKeeper scripts. Values can be provided in\nthe environment or in `conf/java.env`, whose values take precedence. Key\nvariables:"},"1130":{"id":"/admin-ops/tools-25","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"`ZOO_LOG_DIR` — the directory where logs are stored."},"1131":{"id":"/admin-ops/tools-26","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"`ZK_SERVER_HEAP` — configures the server maximum heap in MiB."},"1132":{"id":"/admin-ops/tools-27","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"`SERVER_JVMFLAGS` — additional JVM options for the server."},"1133":{"id":"/admin-ops/tools-28","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"`ZK_CLIENT_HEAP` — configures the client maximum heap in MiB."},"1134":{"id":"/admin-ops/tools-29","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"`CLIENT_JVMFLAGS` — additional JVM options for clients."},"1135":{"id":"/admin-ops/tools-30","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"Heap settings produce the following JVM options:"},"1136":{"id":"/admin-ops/tools-31","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"Heap setting"},"1137":{"id":"/admin-ops/tools-32","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"Server result"},"1138":{"id":"/admin-ops/tools-33","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"Client result"},"1139":{"id":"/admin-ops/tools-34","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"Unset"},"1140":{"id":"/admin-ops/tools-35","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"`-Xmx1000m`"},"1141":{"id":"/admin-ops/tools-36","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"`-Xmx256m`"},"1142":{"id":"/admin-ops/tools-37","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"Positive integer"},"1143":{"id":"/admin-ops/tools-38","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"`-Xmx<number>m`"},"1144":{"id":"/admin-ops/tools-39","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"`-Xmx<number>m`"},"1145":{"id":"/admin-ops/tools-40","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"`omit`"},"1146":{"id":"/admin-ops/tools-41","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"No `-Xmx` generated by ZooKeeper"},"1147":{"id":"/admin-ops/tools-42","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"No `-Xmx` generated by ZooKeeper"},"1148":{"id":"/admin-ops/tools-43","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"Unless the heap setting is `omit`, ZooKeeper prepends the generated `-Xmx`\noption to any options provided in the corresponding `*_JVMFLAGS` variable."},"1149":{"id":"/admin-ops/tools-44","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"The server and client settings are independent. Setting either heap variable to\n`omit` skips only the `-Xmx` option ZooKeeper would otherwise generate from the\ncorresponding heap setting. It does not remove or override options in the corresponding\n`*_JVMFLAGS` variable, including an explicitly supplied `-Xmx` option."},"1150":{"id":"/admin-ops/tools-45","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"Use `omit` when heap-related JVM options should be configured manually. For\nexample, a containerized server can use a percentage of the available memory:"},"1151":{"id":"/admin-ops/tools-46","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkenvsh","content":"It can also be used to provide an `-Xmx` value directly:"},"1152":{"id":"/admin-ops/tools-47","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zkcleanupsh","content":"Clean up old snapshots and transaction logs."},"1153":{"id":"/admin-ops/tools-48","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zktxnlogtoolkitsh","content":"Dump and recover transaction log files with broken CRC entries."},"1154":{"id":"/admin-ops/tools-49","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zktxnlogtoolkitsh","content":"The default behavior is safe — it dumps the entries of the given transaction log file\nto the screen (same as `-d,--dump`):"},"1155":{"id":"/admin-ops/tools-50","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zktxnlogtoolkitsh","content":"In **recovery mode** (`-r,--recover`), the original file is left untouched and all transactions\nare copied to a new file with a `.fixed` suffix. CRC values are recalculated; if the calculated\nvalue does not match the original, the new value is used. By default the tool is interactive,\nasking for confirmation on each CRC error:"},"1156":{"id":"/admin-ops/tools-51","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zktxnlogtoolkitsh","content":"**Yes** — write the recalculated CRC to the new file."},"1157":{"id":"/admin-ops/tools-52","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zktxnlogtoolkitsh","content":"**No** — copy the original CRC value."},"1158":{"id":"/admin-ops/tools-53","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zktxnlogtoolkitsh","content":"**Abort** — abort the operation. The `.fixed` file will not be deleted and may be in a half-complete state."},"1159":{"id":"/admin-ops/tools-54","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zktxnlogtoolkitsh","content":"Use `-v,--verbose` to print all records (not just broken ones). Use `-y,--yes` to fix all\nCRC errors automatically without prompting."},"1160":{"id":"/admin-ops/tools-55","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zksnapshottoolkitsh","content":"Dump a snapshot file to stdout, showing detailed information for each znode."},"1161":{"id":"/admin-ops/tools-56","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zksnapshotrecursivesummarytoolkitsh","content":"Recursively collect and display child count and data size for a selected node."},"1162":{"id":"/admin-ops/tools-57","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zksnapshotcomparersh","content":"Compare two snapshots with configurable thresholds and filters, outputting the delta —\nwhich znodes were added, updated, or deleted. Useful for offline consistency checks and\ndata trend analysis. Only permanent nodes are reported; sessions and ephemeral nodes are ignored."},"1163":{"id":"/admin-ops/tools-58","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zksnapshotcomparersh","content":"Tuning parameters:"},"1164":{"id":"/admin-ops/tools-59","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zksnapshotcomparersh","content":"`--nodes` — threshold for number of descendant nodes added/removed."},"1165":{"id":"/admin-ops/tools-60","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zksnapshotcomparersh","content":"`--bytes` — threshold for bytes added/removed."},"1166":{"id":"/admin-ops/tools-61","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#locating-snapshots","content":"Snapshots are stored in the ZooKeeper data directory\nconfigured in `conf/zoo.cfg`."},"1167":{"id":"/admin-ops/tools-62","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#supported-snapshot-formats","content":"Uncompressed snapshots and compressed formats (`snappy`, `gz`) are all supported.\nSnapshots in different formats can be compared directly without manual decompression."},"1168":{"id":"/admin-ops/tools-63","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#running-the-tool","content":"Running the tool with no arguments prints the help page:"},"1169":{"id":"/admin-ops/tools-64","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#running-the-tool","content":"Example command:"},"1170":{"id":"/admin-ops/tools-65","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#running-the-tool","content":"Example output:"},"1171":{"id":"/admin-ops/tools-66","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#interactive-mode","content":"Add `-i` / `--interactive` to enter interactive mode:"},"1172":{"id":"/admin-ops/tools-67","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#interactive-mode","content":"Three navigation options are available:"},"1173":{"id":"/admin-ops/tools-68","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#interactive-mode","content":"Press **Enter** to print the current depth layer."},"1174":{"id":"/admin-ops/tools-69","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#interactive-mode","content":"Type a **number** to jump to and print all nodes at that depth."},"1175":{"id":"/admin-ops/tools-70","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#interactive-mode","content":"Enter an **absolute path** (starting with `/`) to print the immediate subtree of that node."},"1176":{"id":"/admin-ops/tools-71","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#interactive-mode","content":"Note: only nodes passing the bytes and nodes thresholds are shown."},"1177":{"id":"/admin-ops/tools-72","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#interactive-mode","content":"Press Enter to move to the next depth layer:"},"1178":{"id":"/admin-ops/tools-73","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#interactive-mode","content":"Type a number to jump forward or backward to a specific depth:"},"1179":{"id":"/admin-ops/tools-74","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#interactive-mode","content":"Out-of-range depth is handled gracefully:"},"1180":{"id":"/admin-ops/tools-75","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#interactive-mode","content":"Enter an absolute path to print the immediate subtree of a node:"},"1181":{"id":"/admin-ops/tools-76","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#interactive-mode","content":"Invalid path and invalid input are handled:"},"1182":{"id":"/admin-ops/tools-77","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#interactive-mode","content":"The tool exits interactive mode automatically when all layers are compared, or press `^C` to exit at any time."},"1183":{"id":"/admin-ops/tools-78","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"YCSB (Yahoo Cloud Serving Benchmark) can be used to benchmark ZooKeeper. Follow the steps below to get started."},"1184":{"id":"/admin-ops/tools-79","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"**Start ZooKeeper Server(s)**"},"1185":{"id":"/admin-ops/tools-80","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"Start your ZooKeeper ensemble before running any benchmark."},"1186":{"id":"/admin-ops/tools-81","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"**Install Java and Maven**"},"1187":{"id":"/admin-ops/tools-82","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"Ensure a JDK and Maven are installed on the machine running the benchmark."},"1188":{"id":"/admin-ops/tools-83","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"**Set Up YCSB**"},"1189":{"id":"/admin-ops/tools-84","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"Clone and build the ZooKeeper binding:"},"1190":{"id":"/admin-ops/tools-85","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"See the YCSB README for more details."},"1191":{"id":"/admin-ops/tools-86","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"**Configure ZooKeeper Connection Parameters**"},"1192":{"id":"/admin-ops/tools-87","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"Set the following properties in your workload file or via the shell:"},"1193":{"id":"/admin-ops/tools-88","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"`zookeeper.connectString` — connection string (e.g. `127.0.0.1:2181/benchmark`)"},"1194":{"id":"/admin-ops/tools-89","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"`zookeeper.sessionTimeout` — session timeout in milliseconds"},"1195":{"id":"/admin-ops/tools-90","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"`zookeeper.watchFlag` — enable ZooKeeper watches (`true` or `false`, default `false`). This measures the effect of watch overhead on read/write performance, not watch notification latency."},"1196":{"id":"/admin-ops/tools-91","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"Or set properties directly on the command line (create the `/benchmark` namespace first using `create /benchmark` in the CLI):"},"1197":{"id":"/admin-ops/tools-92","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"**Load Data and Run Tests**"},"1198":{"id":"/admin-ops/tools-93","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"Load data:"},"1199":{"id":"/admin-ops/tools-94","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#ycsb","content":"Run the workload (`workloadb` is recommended as the most representative read-heavy workload):"},"1200":{"id":"/admin-ops/tools-95","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#zk-smoketest","content":"zk-smoketest provides a simple smoketest client\nfor a ZooKeeper ensemble. Useful for verifying new, updated, or existing installations."},"1201":{"id":"/admin-ops/tools-96","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#byteman","content":"Byteman is a tool for tracing, monitoring, and testing Java\napplication and JDK runtime code. It injects Java code into methods without requiring\nrecompilation, repackaging, or redeployment — and injection can be performed at JVM startup\nor while the application is running. See the Byteman tutorial\nfor a quick introduction."},"1202":{"id":"/admin-ops/tools-97","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#byteman","content":"**Example 1:** Force a leader re-election by rolling over the leader's zxid."},"1203":{"id":"/admin-ops/tools-98","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#byteman","content":"**Example 2:** Make the leader drop ping packets to a specific follower. The leader will close\nthe `LearnerHandler` for that follower, and the follower will re-enter the quorum."},"1204":{"id":"/admin-ops/tools-99","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#byteman","content":"**Example 3:** Make a follower drop ACK packets. This has limited effect during broadcast since\nthe leader only needs a majority of ACKs to commit a proposal."},"1205":{"id":"/admin-ops/tools-100","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#jepsen-test","content":"Jepsen is a framework for distributed systems\nverification with fault injection. It has been used to verify eventually-consistent databases,\nlinearizable coordination systems, and distributed task schedulers."},"1206":{"id":"/admin-ops/tools-101","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#jepsen-test","content":"Running the Dockerized Jepsen\nis the simplest way to get started."},"1207":{"id":"/admin-ops/tools-102","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#jepsen-test","content":"Installation:"},"1208":{"id":"/admin-ops/tools-103","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#jepsen-test","content":"Running the test:"},"1209":{"id":"/admin-ops/tools-104","page_id":"/admin-ops/tools","tags":[],"type":"text","url":"/admin-ops/tools#jepsen-test","content":"Read this blog post to learn more\nabout the Jepsen analysis of ZooKeeper."},"1210":{"id":"/developer/basic-tutorial","page_id":"/developer/basic-tutorial","type":"page","content":"Basic tutorial","breadcrumbs":["Multi-Page Documentation","Developer"],"tags":[],"url":"/developer/basic-tutorial"},"1211":{"id":"/developer/basic-tutorial-0","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial","content":"Step-by-step tutorial implementing ZooKeeper-based Barrier and Queue primitives in Java, demonstrating watches, ephemeral nodes, and sequential znodes for distributed coordination."},"1212":{"id":"/developer/basic-tutorial-1","page_id":"/developer/basic-tutorial","type":"heading","tags":[],"url":"/developer/basic-tutorial#introduction","content":"Introduction"},"1213":{"id":"/developer/basic-tutorial-2","page_id":"/developer/basic-tutorial","type":"heading","tags":[],"url":"/developer/basic-tutorial#barriers","content":"Barriers"},"1214":{"id":"/developer/basic-tutorial-3","page_id":"/developer/basic-tutorial","type":"heading","tags":[],"url":"/developer/basic-tutorial#producer-consumer-queues","content":"Producer-Consumer Queues"},"1215":{"id":"/developer/basic-tutorial-4","page_id":"/developer/basic-tutorial","type":"heading","tags":[],"url":"/developer/basic-tutorial#complete-example","content":"Complete example"},"1216":{"id":"/developer/basic-tutorial-5","page_id":"/developer/basic-tutorial","type":"heading","tags":[],"url":"/developer/basic-tutorial#queue-test","content":"Queue test"},"1217":{"id":"/developer/basic-tutorial-6","page_id":"/developer/basic-tutorial","type":"heading","tags":[],"url":"/developer/basic-tutorial#barrier-test","content":"Barrier test"},"1218":{"id":"/developer/basic-tutorial-7","page_id":"/developer/basic-tutorial","type":"heading","tags":[],"url":"/developer/basic-tutorial#source-listing","content":"Source Listing"},"1219":{"id":"/developer/basic-tutorial-8","page_id":"/developer/basic-tutorial","type":"heading","tags":[],"url":"/developer/basic-tutorial#syncprimitivejava","content":"SyncPrimitive.Java"},"1220":{"id":"/developer/basic-tutorial-9","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#introduction","content":"In this tutorial, we show simple implementations of barriers and\nproducer-consumer queues using ZooKeeper. We call the respective classes Barrier and Queue.\nThese examples assume that you have at least one ZooKeeper server running."},"1221":{"id":"/developer/basic-tutorial-10","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#introduction","content":"Both primitives use the following common excerpt of code:"},"1222":{"id":"/developer/basic-tutorial-11","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#introduction","content":"Both classes extend SyncPrimitive. In this way, we execute steps that are\ncommon to all primitives in the constructor of SyncPrimitive. To keep the examples\nsimple, we create a ZooKeeper object the first time we instantiate either a barrier\nobject or a queue object, and we declare a static variable that is a reference\nto this object. The subsequent instances of Barrier and Queue check whether a\nZooKeeper object exists. Alternatively, we could have the application creating a\nZooKeeper object and passing it to the constructor of Barrier and Queue."},"1223":{"id":"/developer/basic-tutorial-12","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#introduction","content":"We use the process() method to process notifications triggered due to watches.\nIn the following discussion, we present code that sets watches. A watch is internal\nstructure that enables ZooKeeper to notify a client of a change to a node. For example,\nif a client is waiting for other clients to leave a barrier, then it can set a watch and\nwait for modifications to a particular node, which can indicate that it is the end of the wait.\nThis point becomes clear once we go over the examples."},"1224":{"id":"/developer/basic-tutorial-13","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#barriers","content":"A barrier is a primitive that enables a group of processes to synchronize the\nbeginning and the end of a computation. The general idea of this implementation\nis to have a barrier node that serves the purpose of being a parent for individual\nprocess nodes. Suppose that we call the barrier node \"/b1\". Each process \"p\" then\ncreates a node \"/b1/p\". Once enough processes have created their corresponding\nnodes, joined processes can start the computation."},"1225":{"id":"/developer/basic-tutorial-14","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#barriers","content":"In this example, each process instantiates a Barrier object, and its constructor takes as parameters:"},"1226":{"id":"/developer/basic-tutorial-15","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#barriers","content":"the address of a ZooKeeper server (e.g., \"zoo1.foo.com:2181\")"},"1227":{"id":"/developer/basic-tutorial-16","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#barriers","content":"the path of the barrier node on ZooKeeper (e.g., \"/b1\")"},"1228":{"id":"/developer/basic-tutorial-17","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#barriers","content":"the size of the group of processes"},"1229":{"id":"/developer/basic-tutorial-18","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#barriers","content":"The constructor of Barrier passes the address of the Zookeeper server to the\nconstructor of the parent class. The parent class creates a ZooKeeper instance if\none does not exist. The constructor of Barrier then creates a\nbarrier node on ZooKeeper, which is the parent node of all process nodes, and\nwe call root (&#x2A;*Note:** This is not the ZooKeeper root \"/\")."},"1230":{"id":"/developer/basic-tutorial-19","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#barriers","content":"To enter the barrier, a process calls enter(). The process creates a node under\nthe root to represent it, using its host name to form the node name. It then wait\nuntil enough processes have entered the barrier. A process does it by checking\nthe number of children the root node has with \"getChildren()\", and waiting for\nnotifications in the case it does not have enough. To receive a notification when\nthere is a change to the root node, a process has to set a watch, and does it\nthrough the call to \"getChildren()\". In the code, we have that \"getChildren()\"\nhas two parameters. The first one states the node to read from, and the second is\na boolean flag that enables the process to set a watch. In the code the flag is true."},"1231":{"id":"/developer/basic-tutorial-20","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#barriers","content":"Note that enter() throws both KeeperException and InterruptedException, so it is\nthe responsibility of the application to catch and handle such exceptions."},"1232":{"id":"/developer/basic-tutorial-21","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#barriers","content":"Once the computation is finished, a process calls leave() to leave the barrier.\nFirst it deletes its corresponding node, and then it gets the children of the root\nnode. If there is at least one child, then it waits for a notification (obs: note\nthat the second parameter of the call to getChildren() is true, meaning that\nZooKeeper has to set a watch on the root node). Upon reception of a notification,\nit checks once more whether the root node has any children."},"1233":{"id":"/developer/basic-tutorial-22","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#producer-consumer-queues","content":"A producer-consumer queue is a distributed data structure that groups of processes\nuse to generate and consume items. Producer processes create new elements and add\nthem to the queue. Consumer processes remove elements from the list, and process them.\nIn this implementation, the elements are simple integers. The queue is represented\nby a root node, and to add an element to the queue, a producer process creates a new node,\na child of the root node."},"1234":{"id":"/developer/basic-tutorial-23","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#producer-consumer-queues","content":"The following excerpt of code corresponds to the constructor of the object. As\nwith Barrier objects, it first calls the constructor of the parent class, SyncPrimitive,\nthat creates a ZooKeeper object if one doesn't exist. It then verifies if the root\nnode of the queue exists, and creates if it doesn't."},"1235":{"id":"/developer/basic-tutorial-24","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#producer-consumer-queues","content":"A producer process calls \"produce()\" to add an element to the queue, and passes\nan integer as an argument. To add an element to the queue, the method creates a\nnew node using \"create()\", and uses the SEQUENCE flag to instruct ZooKeeper to\nappend the value of the sequencer counter associated to the root node. In this way,\nwe impose a total order on the elements of the queue, thus guaranteeing that the\noldest element of the queue is the next one consumed."},"1236":{"id":"/developer/basic-tutorial-25","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#producer-consumer-queues","content":"To consume an element, a consumer process obtains the children of the root node,\nreads the node with smallest counter value, and returns the element. Note that\nif there is a conflict, then one of the two contending processes won't be able to\ndelete the node and the delete operation will throw an exception."},"1237":{"id":"/developer/basic-tutorial-26","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#producer-consumer-queues","content":"A call to getChildren() returns the list of children in lexicographic order.\nAs lexicographic order does not necessarily follow the numerical order of the counter\nvalues, we need to decide which element is the smallest. To decide which one has\nthe smallest counter value, we traverse the list, and remove the prefix \"element\"\nfrom each one."},"1238":{"id":"/developer/basic-tutorial-27","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#complete-example","content":"In the following section you can find a complete command line application to demonstrate the above mentioned\nrecipes. Use the following command to run it."},"1239":{"id":"/developer/basic-tutorial-28","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#queue-test","content":"Start a producer to create 100 elements"},"1240":{"id":"/developer/basic-tutorial-29","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#queue-test","content":"Start a consumer to consume 100 elements"},"1241":{"id":"/developer/basic-tutorial-30","page_id":"/developer/basic-tutorial","tags":[],"type":"text","url":"/developer/basic-tutorial#barrier-test","content":"Start a barrier with 2 participants (start as many times as many participants you'd like to enter)"},"1242":{"id":"/developer/java-example","page_id":"/developer/java-example","type":"page","content":"Java Example","breadcrumbs":["Multi-Page Documentation","Developer"],"tags":[],"url":"/developer/java-example"},"1243":{"id":"/developer/java-example-0","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example","content":"Walks through building a complete ZooKeeper watch client in Java, covering the Executor and DataMonitor design, watcher callbacks, and handling connection state changes."},"1244":{"id":"/developer/java-example-1","page_id":"/developer/java-example","type":"heading","tags":[],"url":"/developer/java-example#a-simple-watch-client","content":"A Simple Watch Client"},"1245":{"id":"/developer/java-example-2","page_id":"/developer/java-example","type":"heading","tags":[],"url":"/developer/java-example#requirements","content":"Requirements"},"1246":{"id":"/developer/java-example-3","page_id":"/developer/java-example","type":"heading","tags":[],"url":"/developer/java-example#program-design","content":"Program Design"},"1247":{"id":"/developer/java-example-4","page_id":"/developer/java-example","type":"heading","tags":[],"url":"/developer/java-example#the-executor-class","content":"The Executor Class"},"1248":{"id":"/developer/java-example-5","page_id":"/developer/java-example","type":"heading","tags":[],"url":"/developer/java-example#the-datamonitor-class","content":"The DataMonitor Class"},"1249":{"id":"/developer/java-example-6","page_id":"/developer/java-example","type":"heading","tags":[],"url":"/developer/java-example#complete-source-listings","content":"Complete Source Listings"},"1250":{"id":"/developer/java-example-7","page_id":"/developer/java-example","type":"heading","tags":[],"url":"/developer/java-example#executorjava","content":"Executor.java"},"1251":{"id":"/developer/java-example-8","page_id":"/developer/java-example","type":"heading","tags":[],"url":"/developer/java-example#datamonitorjava","content":"DataMonitor.java"},"1252":{"id":"/developer/java-example-9","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#a-simple-watch-client","content":"To introduce you to the ZooKeeper Java API, we develop here a very simple\nwatch client. This ZooKeeper client watches a znode for changes\nand responds to by starting or stopping a program."},"1253":{"id":"/developer/java-example-10","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#requirements","content":"The client has four requirements:"},"1254":{"id":"/developer/java-example-11","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#requirements","content":"It takes as parameters:"},"1255":{"id":"/developer/java-example-12","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#requirements","content":"the address of the ZooKeeper service"},"1256":{"id":"/developer/java-example-13","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#requirements","content":"the name of a znode - the one to be watched"},"1257":{"id":"/developer/java-example-14","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#requirements","content":"the name of a file to write the output to"},"1258":{"id":"/developer/java-example-15","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#requirements","content":"an executable with arguments."},"1259":{"id":"/developer/java-example-16","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#requirements","content":"It fetches the data associated with the znode and starts the executable."},"1260":{"id":"/developer/java-example-17","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#requirements","content":"If the znode changes, the client re-fetches the contents and restarts the executable."},"1261":{"id":"/developer/java-example-18","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#requirements","content":"If the znode disappears, the client kills the executable."},"1262":{"id":"/developer/java-example-19","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#program-design","content":"Conventionally, ZooKeeper applications are broken into two units, one which maintains the connection,\nand the other which monitors data. In this application, the class called the **Executor**\nmaintains the ZooKeeper connection, and the class called the **DataMonitor** monitors the data\nin the ZooKeeper tree. Also, Executor contains the main thread and contains the execution logic.\nIt is responsible for what little user interaction there is, as well as interaction with the executable program you\npass in as an argument and which the sample (per the requirements) shuts down and restarts, according to the\nstate of the znode."},"1263":{"id":"/developer/java-example-20","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-executor-class","content":"The Executor object is the primary container of the sample application. It contains\nboth the **ZooKeeper** object, **DataMonitor**, as described above in\nProgram Design."},"1264":{"id":"/developer/java-example-21","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-executor-class","content":"Recall that the Executor's job is to start and stop the executable whose name you pass in on the command line.\nIt does this in response to events fired by the ZooKeeper object. As you can see in the code above, the Executor passes\na reference to itself as the Watcher argument in the ZooKeeper constructor. It also passes a reference to itself\nas DataMonitorListener argument to the DataMonitor constructor. Per the Executor's definition, it implements both these\ninterfaces:"},"1265":{"id":"/developer/java-example-22","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-executor-class","content":"The **Watcher** interface is defined by the ZooKeeper Java API.\nZooKeeper uses it to communicate back to its container. It supports only one method, `process()`,\nand ZooKeeper uses it to communicates generic events that the main thread would be interested in,\nsuch as the state of the ZooKeeper connection or the ZooKeeper session. The Executor in this example simply\nforwards those events down to the DataMonitor to decide what to do with them. It does this simply to illustrate\nthe point that, by convention, the Executor or some Executor-like object \"owns\" the ZooKeeper connection, but it is\nfree to delegate the events to other events to other objects. It also uses this as the default channel on which\nto fire watch events. (More on this later.)"},"1266":{"id":"/developer/java-example-23","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-executor-class","content":"The **DataMonitorListener**\ninterface, on the other hand, is not part of the ZooKeeper API. It is a completely custom interface,\ndesigned for this sample application. The DataMonitor object uses it to communicate back to its container, which\nis also the Executor object. The DataMonitorListener interface looks like this:"},"1267":{"id":"/developer/java-example-24","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-executor-class","content":"This interface is defined in the DataMonitor class and implemented in the Executor class.\nWhen `Executor.exists()` is invoked, the Executor decides whether to start up or shut down per the requirements.\nRecall that the requires say to kill the executable when the znode ceases to *exist*."},"1268":{"id":"/developer/java-example-25","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-executor-class","content":"When `Executor.closing()` is invoked, the Executor decides whether or not to shut itself down\nin response to the ZooKeeper connection permanently disappearing."},"1269":{"id":"/developer/java-example-26","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-executor-class","content":"As you might have guessed, DataMonitor is the object that invokes\nthese methods, in response to changes in ZooKeeper's state."},"1270":{"id":"/developer/java-example-27","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-executor-class","content":"Here are Executor's implementation of\n`DataMonitorListener.exists()` and `DataMonitorListener.closing`:"},"1271":{"id":"/developer/java-example-28","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-datamonitor-class","content":"The DataMonitor class has the meat of the ZooKeeper logic. It is mostly\nasynchronous and event driven. DataMonitor kicks things off in the constructor with:"},"1272":{"id":"/developer/java-example-29","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-datamonitor-class","content":"The call to `ZooKeeper.exists()` checks for the existence of the znode,\nsets a watch, and passes a reference to itself (`this`)\nas the completion callback object. In this sense, it kicks things off, since the\nreal processing happens when the watch is triggered."},"1273":{"id":"/developer/java-example-30","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-datamonitor-class","content":"Don't confuse the completion callback with the watch callback. The `ZooKeeper.exists()`\ncompletion callback, which happens to be the method `StatCallback.processResult()` implemented\nin the DataMonitor object, is invoked when the asynchronous *setting of the watch* operation\n(by `ZooKeeper.exists()`) completes on the server."},"1274":{"id":"/developer/java-example-31","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-datamonitor-class","content":"The triggering of the watch, on the other hand, sends an event to the *Executor* object, since\nthe Executor registered as the Watcher of the ZooKeeper object."},"1275":{"id":"/developer/java-example-32","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-datamonitor-class","content":"As an aside, you might note that the DataMonitor could also register itself as the Watcher\nfor this particular watch event. This is new to ZooKeeper 3.0.0 (the support of multiple Watchers). In this\nexample, however, DataMonitor does not register as the Watcher."},"1276":{"id":"/developer/java-example-33","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-datamonitor-class","content":"When the `ZooKeeper.exists()` operation completes on the server, the ZooKeeper API invokes this completion callback on\nthe client:"},"1277":{"id":"/developer/java-example-34","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-datamonitor-class","content":"The code first checks the error codes for znode existence, fatal errors, and\nrecoverable errors. If the file (or znode) exists, it gets the data from the znode, and\nthen invoke the exists() callback of Executor if the state has changed. Note,\nit doesn't have to do any Exception processing for the getData call because it\nhas watches pending for anything that could cause an error: if the node is deleted\nbefore it calls `ZooKeeper.getData()`, the watch event set by\nthe `ZooKeeper.exists()` triggers a callback;\nif there is a communication error, a connection watch event fires when\nthe connection comes back up."},"1278":{"id":"/developer/java-example-35","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-datamonitor-class","content":"Finally, notice how DataMonitor processes watch events:"},"1279":{"id":"/developer/java-example-36","page_id":"/developer/java-example","tags":[],"type":"text","url":"/developer/java-example#the-datamonitor-class","content":"If the client-side ZooKeeper libraries can re-establish the\ncommunication channel (SyncConnected event) to ZooKeeper before\nsession expiration (Expired event) all of the session's watches will\nautomatically be re-established with the server (auto-reset of watches\nis new in ZooKeeper 3.0.0). See ZooKeeper Watches\nin the programmer guide for more on this. A bit lower down in this\nfunction, when DataMonitor gets an event for a znode, it calls`ZooKeeper.exists()` to find out what has changed."},"1280":{"id":"/developer/programmers-guide/access-control-using-acls","page_id":"/developer/programmers-guide/access-control-using-acls","type":"page","content":"Access Control using ACLs","breadcrumbs":["Multi-Page Documentation","Developer","Programmer's Guide"],"tags":[],"url":"/developer/programmers-guide/access-control-using-acls"},"1281":{"id":"/developer/programmers-guide/access-control-using-acls-0","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls","content":"Explains ZooKeeper's ACL-based access control for znodes, including permission types, built-in ACL schemes (world, auth, digest, host, IP), and the C client API."},"1282":{"id":"/developer/programmers-guide/access-control-using-acls-1","page_id":"/developer/programmers-guide/access-control-using-acls","type":"heading","tags":[],"url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"ACL Permissions"},"1283":{"id":"/developer/programmers-guide/access-control-using-acls-2","page_id":"/developer/programmers-guide/access-control-using-acls","type":"heading","tags":[],"url":"/developer/programmers-guide/access-control-using-acls#builtin-acl-schemes","content":"Builtin ACL Schemes"},"1284":{"id":"/developer/programmers-guide/access-control-using-acls-3","page_id":"/developer/programmers-guide/access-control-using-acls","type":"heading","tags":[],"url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"ZooKeeper C client API"},"1285":{"id":"/developer/programmers-guide/access-control-using-acls-4","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls","content":"ZooKeeper uses ACLs to control access to its znodes (the\ndata nodes of a ZooKeeper data tree). The ACL implementation is\nquite similar to UNIX file access permissions: it employs\npermission bits to allow/disallow various operations against a\nnode and the scope to which the bits apply. Unlike standard UNIX\npermissions, a ZooKeeper node is not limited by the three standard\nscopes for user (owner of the file), group, and world\n(other). ZooKeeper does not have a notion of an owner of a\nznode. Instead, an ACL specifies sets of ids and permissions that\nare associated with those ids."},"1286":{"id":"/developer/programmers-guide/access-control-using-acls-5","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls","content":"Note also that an ACL pertains only to a specific znode. In\nparticular it does not apply to children. For example, if\n*/app&#x2A; is only readable by ip:172.16.16.1 and\n*/app/status&#x2A; is world readable, anyone will\nbe able to read */app/status*; ACLs are not\nrecursive."},"1287":{"id":"/developer/programmers-guide/access-control-using-acls-6","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls","content":"ZooKeeper supports pluggable authentication schemes. Ids are\nspecified using the form *scheme:expression*,\nwhere *scheme* is the authentication scheme\nthat the id corresponds to. The set of valid expressions are defined\nby the scheme. For example, *ip:172.16.16.1* is\nan id for a host with the address *172.16.16.1*\nusing the *ip* scheme, whereas *digest:bob:password*\nis an id for the user with the name of *bob* using\nthe *digest* scheme."},"1288":{"id":"/developer/programmers-guide/access-control-using-acls-7","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls","content":"When a client connects to ZooKeeper and authenticates\nitself, ZooKeeper associates all the ids that correspond to a\nclient with the clients connection. These ids are checked against\nthe ACLs of znodes when a client tries to access a node. ACLs are\nmade up of pairs of &#x2A;(scheme:expression,\nperms)*. The format of\nthe *expression&#x2A; is specific to the scheme. For\nexample, the pair &#x2A;(ip:19.22.0.0/16, READ)*\ngives the *READ* permission to any clients with\nan IP address that starts with 19.22."},"1289":{"id":"/developer/programmers-guide/access-control-using-acls-8","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"ZooKeeper supports the following permissions:"},"1290":{"id":"/developer/programmers-guide/access-control-using-acls-9","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"**CREATE**: you can create a child node"},"1291":{"id":"/developer/programmers-guide/access-control-using-acls-10","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"**READ**: you can get data from a node and list its children."},"1292":{"id":"/developer/programmers-guide/access-control-using-acls-11","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"**WRITE**: you can set data for a node"},"1293":{"id":"/developer/programmers-guide/access-control-using-acls-12","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"**DELETE**: you can delete a child node"},"1294":{"id":"/developer/programmers-guide/access-control-using-acls-13","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"**ADMIN**: you can set permissions"},"1295":{"id":"/developer/programmers-guide/access-control-using-acls-14","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"The *CREATE*\nand *DELETE* permissions have been broken out\nof the *WRITE* permission for finer grained\naccess controls. The cases for *CREATE*\nand *DELETE* are the following:"},"1296":{"id":"/developer/programmers-guide/access-control-using-acls-15","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"You want A to be able to do a set on a ZooKeeper node, but\nnot be able to *CREATE*\nor *DELETE* children."},"1297":{"id":"/developer/programmers-guide/access-control-using-acls-16","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"*CREATE*\nwithout *DELETE*: clients create requests by\ncreating ZooKeeper nodes in a parent directory. You want all\nclients to be able to add, but only request processor can\ndelete. (This is kind of like the APPEND permission for\nfiles.)"},"1298":{"id":"/developer/programmers-guide/access-control-using-acls-17","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"Also, the *ADMIN* permission is there\nsince ZooKeeper doesn’t have a notion of file owner. In some\nsense the *ADMIN* permission designates the\nentity as the owner. ZooKeeper doesn’t support the LOOKUP\npermission (execute permission bit on directories to allow you\nto LOOKUP even though you can't list the directory). Everyone\nimplicitly has LOOKUP permission. This allows you to stat a\nnode, but nothing more. (The problem is, if you want to call\nzoo\\_exists() on a node that doesn't exist, there is no\npermission to check.)"},"1299":{"id":"/developer/programmers-guide/access-control-using-acls-18","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"*ADMIN* permission also has a special role in terms of ACLs:\nin order to retrieve ACLs of a znode user has to have *READ* or *ADMIN*\npermission, but without *ADMIN* permission, digest hash values will be\nmasked out."},"1300":{"id":"/developer/programmers-guide/access-control-using-acls-19","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#acl-permissions","content":"As of versions **3.9.2 / 3.8.4 / 3.7.3** the exists() call will now verify ACLs\non nodes that exist and the client must have READ permission otherwise\n'Insufficient permission' error will be raised."},"1301":{"id":"/developer/programmers-guide/access-control-using-acls-20","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#builtin-acl-schemes","content":"ZooKeeper has the following built in schemes:"},"1302":{"id":"/developer/programmers-guide/access-control-using-acls-21","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#builtin-acl-schemes","content":"**world** has a\nsingle id, *anyone*, that represents\nanyone."},"1303":{"id":"/developer/programmers-guide/access-control-using-acls-22","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#builtin-acl-schemes","content":"**auth** is a special\nscheme which ignores any provided expression and instead uses the current user,\ncredentials, and scheme. Any expression (whether *user* like with SASL\nauthentication or *user:password* like with DIGEST authentication) provided is ignored\nby the ZooKeeper server when persisting the ACL. However, the expression must still be\nprovided in the ACL because the ACL must match the form *scheme:expression:perms*.\nThis scheme is provided as a convenience as it is a common use-case for\na user to create a znode and then restrict access to that znode to only that user.\nIf there is no authenticated user, setting an ACL with the auth scheme will fail."},"1304":{"id":"/developer/programmers-guide/access-control-using-acls-23","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#builtin-acl-schemes","content":"**digest** uses\na *username:password* string to generate\nMD5 hash which is then used as an ACL ID\nidentity. Authentication is done by sending\nthe *username:password* in clear text. When\nused in the ACL the expression will be\nthe *username:base64*\nencoded *SHA1*\npassword *digest*."},"1305":{"id":"/developer/programmers-guide/access-control-using-acls-24","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#builtin-acl-schemes","content":"**ip** uses the\nclient host IP as an ACL ID identity. The ACL expression is of\nthe form *addr/bits* where the most\nsignificant *bits*\nof *addr* are matched against the most\nsignificant *bits* of the client host\nIP."},"1306":{"id":"/developer/programmers-guide/access-control-using-acls-25","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#builtin-acl-schemes","content":"**x509** uses the client\nX500 Principal as an ACL ID identity. The ACL expression is the exact\nX500 Principal name of a client. When using the secure port, clients\nare automatically authenticated and their auth info for the x509 scheme\nis set."},"1307":{"id":"/developer/programmers-guide/access-control-using-acls-26","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"The following constants are provided by the ZooKeeper C\nlibrary:"},"1308":{"id":"/developer/programmers-guide/access-control-using-acls-27","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*const* *int* ZOO\\_PERM\\_READ; //can read node’s value and list its children"},"1309":{"id":"/developer/programmers-guide/access-control-using-acls-28","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*const* *int* ZOO\\_PERM\\_WRITE;// can set the node’s value"},"1310":{"id":"/developer/programmers-guide/access-control-using-acls-29","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*const* *int* ZOO\\_PERM\\_CREATE; //can create children"},"1311":{"id":"/developer/programmers-guide/access-control-using-acls-30","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*const* *int* ZOO\\_PERM\\_DELETE;// can delete children"},"1312":{"id":"/developer/programmers-guide/access-control-using-acls-31","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*const* *int* ZOO\\_PERM\\_ADMIN; //can execute set\\_acl()"},"1313":{"id":"/developer/programmers-guide/access-control-using-acls-32","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*const* *int* ZOO\\_PERM\\_ALL;// all of the above flags OR’d together"},"1314":{"id":"/developer/programmers-guide/access-control-using-acls-33","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"The following are the standard ACL IDs:"},"1315":{"id":"/developer/programmers-guide/access-control-using-acls-34","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*struct* Id ZOO\\_ANYONE\\_ID\\_UNSAFE; //(‘world’,’anyone’)"},"1316":{"id":"/developer/programmers-guide/access-control-using-acls-35","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*struct* Id ZOO\\_AUTH\\_IDS;// (‘auth’,’’)"},"1317":{"id":"/developer/programmers-guide/access-control-using-acls-36","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"ZOO\\_AUTH\\_IDS empty identity string should be interpreted as “the identity of the creator”."},"1318":{"id":"/developer/programmers-guide/access-control-using-acls-37","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"ZooKeeper client comes with three standard ACLs:"},"1319":{"id":"/developer/programmers-guide/access-control-using-acls-38","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*struct* ACL\\_vector ZOO\\_OPEN\\_ACL\\_UNSAFE; //(ZOO\\_PERM\\_ALL,ZOO\\_ANYONE\\_ID\\_UNSAFE)"},"1320":{"id":"/developer/programmers-guide/access-control-using-acls-39","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*struct* ACL\\_vector ZOO\\_READ\\_ACL\\_UNSAFE;// (ZOO\\_PERM\\_READ, ZOO\\_ANYONE\\_ID\\_UNSAFE)"},"1321":{"id":"/developer/programmers-guide/access-control-using-acls-40","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*struct* ACL\\_vector ZOO\\_CREATOR\\_ALL\\_ACL; //(ZOO\\_PERM\\_ALL,ZOO\\_AUTH\\_IDS)"},"1322":{"id":"/developer/programmers-guide/access-control-using-acls-41","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"The ZOO*OPEN\\_ACL\\_UNSAFE is completely open free for all\nACL: any application can execute any operation on the node and\ncan create, list and delete its children. The\nZOO\\_READ\\_ACL\\_UNSAFE is read-only access for any\napplication. CREATE\\_ALL\\_ACL grants all permissions to the\ncreator of the node. The creator must have been authenticated by\nthe server (for example, using “\\_digest*”\nscheme) before it can create nodes with this ACL."},"1323":{"id":"/developer/programmers-guide/access-control-using-acls-42","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"The following ZooKeeper operations deal with ACLs:"},"1324":{"id":"/developer/programmers-guide/access-control-using-acls-43","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*int* *zoo\\_add\\_auth*\n(zhandle*t \\*zh,\\_const* &#x2A;char\\_\\_\nscheme,*const* *char**\ncert, *int* certLen, void*completion\\_t\ncompletion, \\_const* *void*\n\\*data);"},"1325":{"id":"/developer/programmers-guide/access-control-using-acls-44","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"The application uses the zoo\\_add\\_auth function to\nauthenticate itself to the server. The function can be called\nmultiple times if the application wants to authenticate using\ndifferent schemes and/or identities."},"1326":{"id":"/developer/programmers-guide/access-control-using-acls-45","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*int* *zoo\\_create*\n(zhandle*t \\*zh, \\_const* *char*\n\\*path, *const* *char*\n\\*value,*int*\nvaluelen, *const* *struct*\nACL*vector \\*acl, \\_int*\nflags,*char*\n\\*realpath, *int*\nmax\\_realpath\\_len);"},"1327":{"id":"/developer/programmers-guide/access-control-using-acls-46","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"zoo\\_create(...) operation creates a new node. The acl\nparameter is a list of ACLs associated with the node. The parent\nnode must have the CREATE permission bit set."},"1328":{"id":"/developer/programmers-guide/access-control-using-acls-47","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*int* *zoo\\_get\\_acl*\n(zhandle*t \\*zh, \\_const* *char*\n\\*path,*struct* ACL*vector\n\\*acl, \\_struct* Stat \\*stat);"},"1329":{"id":"/developer/programmers-guide/access-control-using-acls-48","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"This operation returns a node’s ACL info. The node must have READ or ADMIN\npermission set. Without ADMIN permission, the digest hash values will be masked out."},"1330":{"id":"/developer/programmers-guide/access-control-using-acls-49","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"*int* *zoo\\_set\\_acl*\n(zhandle*t \\*zh, \\_const* *char*\n\\*path, *int*\nversion,*const* *struct*\nACL\\_vector \\*acl);"},"1331":{"id":"/developer/programmers-guide/access-control-using-acls-50","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"This function replaces node’s ACL list with a new one. The\nnode must have the ADMIN permission set."},"1332":{"id":"/developer/programmers-guide/access-control-using-acls-51","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"Here is a sample code that makes use of the above APIs to\nauthenticate itself using the “*foo*” scheme\nand create an ephemeral node “/xyz” with create-only\npermissions."},"1333":{"id":"/developer/programmers-guide/access-control-using-acls-52","page_id":"/developer/programmers-guide/access-control-using-acls","tags":[],"type":"text","url":"/developer/programmers-guide/access-control-using-acls#zookeeper-c-client-api","content":"This is a very simple example which is intended to show how to interact with\nZooKeeper ACLs specifically. See\n*.../trunk/zookeeper-client/zookeeper-client-c/src/cli.c* for an example of a\nC client implementation"},"1334":{"id":"/developer/programmers-guide/bindings","page_id":"/developer/programmers-guide/bindings","type":"page","content":"Bindings","breadcrumbs":["Multi-Page Documentation","Developer","Programmer's Guide"],"tags":[],"url":"/developer/programmers-guide/bindings"},"1335":{"id":"/developer/programmers-guide/bindings-0","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings","content":"Documents the Java and C client library bindings for ZooKeeper, including the ZooKeeper class, callbacks, POSIX-style C API, multithreaded and single-threaded libraries."},"1336":{"id":"/developer/programmers-guide/bindings-1","page_id":"/developer/programmers-guide/bindings","type":"heading","tags":[],"url":"/developer/programmers-guide/bindings#java-binding","content":"Java Binding"},"1337":{"id":"/developer/programmers-guide/bindings-2","page_id":"/developer/programmers-guide/bindings","type":"heading","tags":[],"url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"Client Configuration Parameters"},"1338":{"id":"/developer/programmers-guide/bindings-3","page_id":"/developer/programmers-guide/bindings","type":"heading","tags":[],"url":"/developer/programmers-guide/bindings#c-binding","content":"C Binding"},"1339":{"id":"/developer/programmers-guide/bindings-4","page_id":"/developer/programmers-guide/bindings","type":"heading","tags":[],"url":"/developer/programmers-guide/bindings#installation","content":"Installation"},"1340":{"id":"/developer/programmers-guide/bindings-5","page_id":"/developer/programmers-guide/bindings","type":"heading","tags":[],"url":"/developer/programmers-guide/bindings#building-your-own-c-client","content":"Building Your Own C Client"},"1341":{"id":"/developer/programmers-guide/bindings-6","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings","content":"The ZooKeeper client libraries come in two languages: Java and C.\nThe following sections describe these."},"1342":{"id":"/developer/programmers-guide/bindings-7","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#java-binding","content":"There are two packages that make up the ZooKeeper Java binding:\n**org.apache.zookeeper** and **org.apache.zookeeper.data**. The rest of the\npackages that make up ZooKeeper are used internally or are part of the\nserver implementation. The **org.apache.zookeeper.data** package is made up of\ngenerated classes that are used simply as containers."},"1343":{"id":"/developer/programmers-guide/bindings-8","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#java-binding","content":"The main class used by a ZooKeeper Java client is the **ZooKeeper** class. Its two constructors differ only\nby an optional session id and password. ZooKeeper supports session\nrecovery across instances of a process. A Java program may save its\nsession id and password to stable storage, restart, and recover the\nsession that was used by the earlier instance of the program."},"1344":{"id":"/developer/programmers-guide/bindings-9","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#java-binding","content":"When a ZooKeeper object is created, two threads are created as\nwell: an IO thread and an event thread. All IO happens on the IO thread\n(using Java NIO). All event callbacks happen on the event thread.\nSession maintenance such as reconnecting to ZooKeeper servers and\nmaintaining heartbeat is done on the IO thread. Responses for\nsynchronous methods are also processed in the IO thread. All responses\nto asynchronous methods and watch events are processed on the event\nthread. There are a few things to notice that result from this\ndesign:"},"1345":{"id":"/developer/programmers-guide/bindings-10","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#java-binding","content":"All completions for asynchronous calls and watcher callbacks\nwill be made in order, one at a time. The caller can do any\nprocessing they wish, but no other callbacks will be processed\nduring that time."},"1346":{"id":"/developer/programmers-guide/bindings-11","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#java-binding","content":"Callbacks do not block the processing of the IO thread or the\nprocessing of the synchronous calls."},"1347":{"id":"/developer/programmers-guide/bindings-12","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#java-binding","content":"Synchronous calls may not return in the correct order. For\nexample, assume a client does the following processing: issues an\nasynchronous read of node **/a** with\n*watch&#x2A; set to true, and then in the completion\ncallback of the read it does a synchronous read of **/a*&#x2A;. (Maybe not good practice, but not illegal\neither, and it makes for a simple example.)\nNote that if there is a change to **/a*&#x2A; between the asynchronous read and the\nsynchronous read, the client library will receive the watch event\nsaying **/a*&#x2A; changed before the\nresponse for the synchronous read, but because of the completion\ncallback blocking the event queue, the synchronous read will\nreturn with the new value of **/a**\nbefore the watch event is processed."},"1348":{"id":"/developer/programmers-guide/bindings-13","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#java-binding","content":"Finally, the rules associated with shutdown are straightforward:\nonce a ZooKeeper object is closed or receives a fatal event\n(SESSION\\_EXPIRED and AUTH\\_FAILED), the ZooKeeper object becomes invalid.\nOn a close, the two threads shut down and any further access on zookeeper\nhandle is undefined behavior and should be avoided."},"1349":{"id":"/developer/programmers-guide/bindings-14","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"The following list contains configuration properties for the Java client. You can set any\nof these properties using Java system properties. For server properties, please check the\nServer configuration section of the Admin Guide.\nThe ZooKeeper Wiki also has useful pages about\nZooKeeper SSL support,\nand SASL authentication for ZooKeeper."},"1350":{"id":"/developer/programmers-guide/bindings-15","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.sasl.client* :\nSet the value to **false** to disable\nSASL authentication. Default is **true**."},"1351":{"id":"/developer/programmers-guide/bindings-16","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.sasl.clientconfig* :\nSpecifies the context key in the JAAS login file. Default is \"Client\"."},"1352":{"id":"/developer/programmers-guide/bindings-17","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.server.principal* :\nSpecifies the server principal to be used by the client for authentication, while connecting to the zookeeper\nserver, when Kerberos authentication is enabled. If this configuration is provided, then\nthe ZooKeeper client will NOT USE any of the following parameters to determine the server principal:"},"1353":{"id":"/developer/programmers-guide/bindings-18","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.sasl.client.username* :\nTraditionally, a principal is divided into three parts: the primary, the instance, and the realm.\nThe format of a typical Kerberos V5 principal is primary/instance\\@REALM.\nzookeeper.sasl.client.username specifies the primary part of the server principal. Default\nis \"zookeeper\". Instance part is derived from the server IP. Finally server's principal is\nusername/IP\\@realm, where username is the value of zookeeper.sasl.client.username, IP is\nthe server IP, and realm is the value of zookeeper.server.realm."},"1354":{"id":"/developer/programmers-guide/bindings-19","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.sasl.client.canonicalize.hostname* :\nExpecting the zookeeper.server.principal parameter is not provided, the ZooKeeper client will try to\ndetermine the 'instance' (host) part of the ZooKeeper server principal. First it takes the hostname provided\nas the ZooKeeper server connection string. Then it tries to 'canonicalize' the address by getting\nthe fully qualified domain name belonging to the address. You can disable this 'canonicalization'\nby setting: zookeeper.sasl.client.canonicalize.hostname=false"},"1355":{"id":"/developer/programmers-guide/bindings-20","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.sasl.client.allowReverseDnsLookup* :\n&#x2A;*New in 3.9.5:**\nControls whether reverse DNS lookup is enabled when constructing the server principal for the SASL client.\nDefault: false"},"1356":{"id":"/developer/programmers-guide/bindings-21","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.server.realm* :\nRealm part of the server principal. By default it is the client principal realm."},"1357":{"id":"/developer/programmers-guide/bindings-22","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.kerberos.shutdownTimeoutMs* :\n&#x2A;*New in 3.10.0:**\nThe time in milliseconds a client waits for the Kerberos TGT renewal thread to exit while closing.\nIf the thread is still alive after that, the client logs a warning and completes the close.\nSet it to 0 to wait without a timeout, which is how the client behaved before this setting existed.\nDefault: 5000"},"1358":{"id":"/developer/programmers-guide/bindings-23","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.disableAutoWatchReset* :\nThis switch controls whether automatic watch resetting is enabled. Clients automatically\nreset watches during session reconnect by default, this option allows the client to turn off\nthis behavior by setting zookeeper.disableAutoWatchReset to **true**."},"1359":{"id":"/developer/programmers-guide/bindings-24","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.client.secure* :\n&#x2A;*New in 3.5.5:**\nIf you want to connect to the server secure client port, you need to set this property to\n**true**\non the client. This will connect to server using SSL with specified credentials. Note that\nit requires the Netty client."},"1360":{"id":"/developer/programmers-guide/bindings-25","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.clientCnxnSocket* :\nSpecifies which ClientCnxnSocket to be used. Possible values are\n**org.apache.zookeeper.ClientCnxnSocketNIO**\nand\n**org.apache.zookeeper.ClientCnxnSocketNetty**\n. Default is\n**org.apache.zookeeper.ClientCnxnSocketNIO**\n. If you want to connect to server's secure client port, you need to set this property to\n**org.apache.zookeeper.ClientCnxnSocketNetty**\non client."},"1361":{"id":"/developer/programmers-guide/bindings-26","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.ssl.keyStore.location and zookeeper.ssl.keyStore.password* :\n&#x2A;*New in 3.5.5:**\nSpecifies the file path to a JKS containing the local credentials to be used for SSL connections,\nand the password to unlock the file."},"1362":{"id":"/developer/programmers-guide/bindings-27","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.ssl.keyStore.passwordPath* :\n&#x2A;*New in 3.8.0:**\nSpecifies the file path which contains the keystore password"},"1363":{"id":"/developer/programmers-guide/bindings-28","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.ssl.trustStore.location and zookeeper.ssl.trustStore.password* :\n&#x2A;*New in 3.5.5:**\nSpecifies the file path to a JKS containing the remote credentials to be used for SSL connections,\nand the password to unlock the file."},"1364":{"id":"/developer/programmers-guide/bindings-29","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.ssl.trustStore.passwordPath* :\n&#x2A;*New in 3.8.0:**\nSpecifies the file path which contains the truststore password"},"1365":{"id":"/developer/programmers-guide/bindings-30","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.ssl.keyStore.type* and *zookeeper.ssl.trustStore.type*:\n&#x2A;*New in 3.5.5:**\nSpecifies the file format of keys/trust store files used to establish TLS connection to the ZooKeeper server.\nValues: JKS, PEM, PKCS12 or null (detect by filename). Default: null.\n&#x2A;*New in 3.6.3, 3.7.0:**\nThe format BCFKS was added."},"1366":{"id":"/developer/programmers-guide/bindings-31","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*jute.maxbuffer* :\nIn the client side, it specifies the maximum size of the incoming data from the server. The default is 0xfffff(1048575) bytes,\nor just under 1M. This is really a sanity check. The ZooKeeper server is designed to store and send\ndata on the order of kilobytes. If incoming data length is more than this value, an IOException\nis raised. This value of client side should keep same with the server side(Setting &#x2A;*System.setProperty(\"jute.maxbuffer\", \"xxxx\")** in the client side will work),\notherwise problems will arise."},"1367":{"id":"/developer/programmers-guide/bindings-32","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.kinit* :\nSpecifies path to kinit binary. Default is \"/usr/bin/kinit\"."},"1368":{"id":"/developer/programmers-guide/bindings-33","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.shuffleDnsResponse* :\n&#x2A;*New in 3.10.0:**\nSpecifies whether ZooKeeper client should randomly pick an IP address from the DNS lookup query result when resolving\nserver addresses or not. This is a feature flag in order to keep the old behavior of the default DNS resolver in\n`StaticHostProvider`, because we disabled it by default. The reason behind that is shuffling the response of DNS queries\nshadows JVM network property `java.net.preferIPv6Addresses` (default: false). This property controls whether JVM's built-in\nresolver should prioritize v4 (false value) or v6 (true value) addresses when putting together the list of IP addresses\nin the result. In other words the above Java system property was completely ineffective in the case of ZooKeeper server host\nresolution protocol and this must have been fixed. In a dual stack environment one might want to prefer one stack over\nthe other which, in case of Java processes, should be controlled by JVM network properties and ZooKeeper must honor\nthese settings. Since the old behavior has been with us since day zero, we introduced this feature flag in case you\nneed it. Such case could be when you have a buggy DNS server which responds IP addresses always in the same order and\nyou want to randomize that.\nDefault: false"},"1369":{"id":"/developer/programmers-guide/bindings-34","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#client-configuration-parameters","content":"*zookeeper.hostProvider.dnsSrvRefreshIntervalSeconds* :\n&#x2A;*New in 3.10.0:**\nSpecifies the refresh interval in seconds for DNS SRV record lookups when using DnsSrvHostProvider.\nA value of 0 disables periodic refresh.\nDefault: 60 seconds"},"1370":{"id":"/developer/programmers-guide/bindings-35","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#c-binding","content":"The C binding has a single-threaded and multi-threaded library.\nThe multi-threaded library is easiest to use and is most similar to the\nJava API. This library will create an IO thread and an event dispatch\nthread for handling connection maintenance and callbacks. The\nsingle-threaded library allows ZooKeeper to be used in event driven\napplications by exposing the event loop used in the multi-threaded\nlibrary."},"1371":{"id":"/developer/programmers-guide/bindings-36","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#c-binding","content":"The package includes two shared libraries: zookeeper*st and\nzookeeper\\_mt. The former only provides the asynchronous APIs and\ncallbacks for integrating into the application's event loop. The only\nreason this library exists is to support the platforms were a\n\\_pthread* library is not available or is unstable\n(i.e. FreeBSD 4.x). In all other cases, application developers should\nlink with zookeeper\\_mt, as it includes support for both Sync and Async\nAPI."},"1372":{"id":"/developer/programmers-guide/bindings-37","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#installation","content":"If you're building the client from a check-out from the Apache\nrepository, follow the steps outlined below. If you're building from a\nproject source package downloaded from apache, skip to step **3**."},"1373":{"id":"/developer/programmers-guide/bindings-38","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#installation","content":"Run `mvn compile&#x60; in zookeeper-jute directory (*.../trunk/zookeeper-jute&#x2A;).\nThis will create a directory named \"generated\" under\n*.../trunk/zookeeper-client/zookeeper-client-c*."},"1374":{"id":"/developer/programmers-guide/bindings-39","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#installation","content":"Change directory to the\\*.../trunk/zookeeper-client/zookeeper-client-c\\*\nand run `autoreconf -if` to bootstrap **autoconf**, **automake** and **libtool**. Make sure you have **autoconf version 2.59** or greater installed.\nSkip to step**4**."},"1375":{"id":"/developer/programmers-guide/bindings-40","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#installation","content":"If you are building from a project source package,\nunzip/untar the source tarball and cd to the\\*\nzookeeper-x.x.x/zookeeper-client/zookeeper-client-c\\* directory."},"1376":{"id":"/developer/programmers-guide/bindings-41","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#installation","content":"Run `./configure <your-options>` to\ngenerate the makefile. Here are some of options the **configure** utility supports that can be\nuseful in this step:"},"1377":{"id":"/developer/programmers-guide/bindings-42","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#installation","content":"`--enable-debug`\nEnables optimization and enables debug info compiler\noptions. (Disabled by default.)"},"1378":{"id":"/developer/programmers-guide/bindings-43","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#installation","content":"`--without-syncapi`\nDisables Sync API support; zookeeper\\_mt library won't be\nbuilt. (Enabled by default.)"},"1379":{"id":"/developer/programmers-guide/bindings-44","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#installation","content":"`--disable-static`\nDo not build static libraries. (Enabled by\ndefault.)"},"1380":{"id":"/developer/programmers-guide/bindings-45","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#installation","content":"`--disable-shared`\nDo not build shared libraries. (Enabled by\ndefault.)"},"1381":{"id":"/developer/programmers-guide/bindings-46","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#installation","content":"See INSTALL for general information about running **configure**. 1. Run\n`make` or `make install` to build the libraries and install them. 1. To\ngenerate doxygen documentation for the ZooKeeper API, run `make\n  doxygen-doc`. All documentation will be placed in a new subfolder named\ndocs. By default, this command only generates HTML. For information on other\ndocument formats, run `./configure --help`"},"1382":{"id":"/developer/programmers-guide/bindings-47","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#building-your-own-c-client","content":"In order to be able to use the ZooKeeper C API in your application\nyou have to remember to"},"1383":{"id":"/developer/programmers-guide/bindings-48","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#building-your-own-c-client","content":"Include ZooKeeper header: `#include <zookeeper/zookeeper.h>`"},"1384":{"id":"/developer/programmers-guide/bindings-49","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#building-your-own-c-client","content":"If you are building a multithreaded client, compile with\n`-DTHREADED` compiler flag to enable the multi-threaded version of\nthe library, and then link against the\n*zookeeper\\_mt* library. If you are building a\nsingle-threaded client, do not compile with `-DTHREADED`, and be\nsure to link against the\\_zookeeper\\_st\\_library."},"1385":{"id":"/developer/programmers-guide/bindings-50","page_id":"/developer/programmers-guide/bindings","tags":[],"type":"text","url":"/developer/programmers-guide/bindings#building-your-own-c-client","content":"See *.../trunk/zookeeper-client/zookeeper-client-c/src/cli.c* for an example\nof a C client implementation"},"1386":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","type":"page","content":"Building Blocks: A Guide to ZooKeeper Operations","breadcrumbs":["Multi-Page Documentation","Developer","Programmer's Guide"],"tags":[],"url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations"},"1387":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-0","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","content":"A practical reference for all operations a developer can perform against a ZooKeeper server, covering error handling, connecting, and the full synchronous and asynchronous API."},"1388":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-1","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","type":"heading","tags":[],"url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#handling-errors","content":"Handling Errors"},"1389":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-2","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","type":"heading","tags":[],"url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"Connecting to ZooKeeper"},"1390":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-3","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","content":"This section surveys all the operations a developer can perform\nagainst a ZooKeeper server. It is lower level information than the earlier\nconcepts chapters in this manual, but higher level than the ZooKeeper API\nReference."},"1391":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-4","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#handling-errors","content":"Both the Java and C client bindings may report errors. The Java client binding does so by throwing KeeperException, calling code() on the exception will return the specific error code. The C client binding returns an error code as defined in the enum ZOO\\_ERRORS. API callbacks indicate result code for both language bindings. See the API documentation (javadoc for Java, doxygen for C) for full details on the possible errors and their meaning."},"1392":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-5","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"Before we begin, you will have to set up a running Zookeeper server so that we can start developing the client. For C client bindings, we will be using the multithreaded library(zookeeper*mt) with a simple example written in C. To establish a connection with Zookeeper server, we make use of C API - \\_zookeeper\\_init* with the following signature:"},"1393":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-6","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"int zookeeper\\_init(const char \\*host, watcher\\_fn fn, int recv\\_timeout, const clientid\\_t \\*clientid, void \\*context, int flags);"},"1394":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-7","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"\\**host* :\nConnection string to zookeeper server in the format of host:port. If there are multiple servers, use comma as separator after specifying the host:port pairs. Eg: \"127.0.0.1:2181,127.0.0.1:3001,127.0.0.1:3002\""},"1395":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-8","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"*fn* :\nWatcher function to process events when a notification is triggered."},"1396":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-9","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"*recv\\_timeout* :\nSession expiration time in milliseconds."},"1397":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-10","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"\\**clientid* :\nWe can specify 0 for a new session. If a session has already establish previously, we could provide that client ID and it would reconnect to that previous session."},"1398":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-11","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"\\**context* :\nContext object that can be associated with the zkhandle\\_t handler. If it is not used, we can set it to 0."},"1399":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-12","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"*flags* :\nIn an initiation, we can leave it for 0."},"1400":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-13","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"We will demonstrate client that outputs \"Connected to Zookeeper\" after successful connection or an error message otherwise. Let's call the following code *zkClient.cc*:"},"1401":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-14","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"Compile the code with the multithreaded library mentioned before."},"1402":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-15","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"`> g++ -Iinclude/ zkClient.cpp -lzookeeper_mt -o Client`"},"1403":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-16","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"Run the client."},"1404":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-17","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"`> ./Client`"},"1405":{"id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations-18","page_id":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations","tags":[],"type":"text","url":"/developer/programmers-guide/building-blocks-a-guide-to-zookeeper-operations#connecting-to-zookeeper","content":"From the output, you should see \"Connected to Zookeeper\" along with Zookeeper's DEBUG messages if the connection is successful."},"1406":{"id":"/developer/programmers-guide/consistency-guarantees","page_id":"/developer/programmers-guide/consistency-guarantees","type":"page","content":"Consistency Guarantees","breadcrumbs":["Multi-Page Documentation","Developer","Programmer's Guide"],"tags":[],"url":"/developer/programmers-guide/consistency-guarantees"},"1407":{"id":"/developer/programmers-guide/consistency-guarantees-0","page_id":"/developer/programmers-guide/consistency-guarantees","tags":[],"type":"text","url":"/developer/programmers-guide/consistency-guarantees","content":"Details ZooKeeper's consistency guarantees: sequential consistency, atomicity, single system image, reliability, and timeliness, and how they compare to other distributed systems."},"1408":{"id":"/developer/programmers-guide/consistency-guarantees-1","page_id":"/developer/programmers-guide/consistency-guarantees","tags":[],"type":"text","url":"/developer/programmers-guide/consistency-guarantees","content":"ZooKeeper is a high performance, scalable service. Both reads and\nwrite operations are designed to be fast, though reads are faster than\nwrites. The reason for this is that in the case of reads, ZooKeeper can\nserve older data, which in turn is due to ZooKeeper's consistency\nguarantees:"},"1409":{"id":"/developer/programmers-guide/consistency-guarantees-2","page_id":"/developer/programmers-guide/consistency-guarantees","tags":[],"type":"text","url":"/developer/programmers-guide/consistency-guarantees","content":"*Sequential Consistency* :\nUpdates from a client will be applied in the order that they\nwere sent."},"1410":{"id":"/developer/programmers-guide/consistency-guarantees-3","page_id":"/developer/programmers-guide/consistency-guarantees","tags":[],"type":"text","url":"/developer/programmers-guide/consistency-guarantees","content":"*Atomicity* :\nUpdates either succeed or fail — there are no partial\nresults."},"1411":{"id":"/developer/programmers-guide/consistency-guarantees-4","page_id":"/developer/programmers-guide/consistency-guarantees","tags":[],"type":"text","url":"/developer/programmers-guide/consistency-guarantees","content":"*Single System Image* :\nA client will see the same view of the service regardless of\nthe server that it connects to. i.e., a client will never see an\nolder view of the system even if the client fails over to a\ndifferent server with the same session."},"1412":{"id":"/developer/programmers-guide/consistency-guarantees-5","page_id":"/developer/programmers-guide/consistency-guarantees","tags":[],"type":"text","url":"/developer/programmers-guide/consistency-guarantees","content":"*Reliability* :\nOnce an update has been applied, it will persist from that\ntime forward until a client overwrites the update. This guarantee\nhas two corollaries:"},"1413":{"id":"/developer/programmers-guide/consistency-guarantees-6","page_id":"/developer/programmers-guide/consistency-guarantees","tags":[],"type":"text","url":"/developer/programmers-guide/consistency-guarantees","content":"If a client gets a successful return code, the update will\nhave been applied. On some failures (communication errors,\ntimeouts, etc) the client will not know if the update has\napplied or not. We take steps to minimize the failures, but the\nguarantee is only present with successful return codes.\n(This is called the *monotonicity condition* in Paxos.)"},"1414":{"id":"/developer/programmers-guide/consistency-guarantees-7","page_id":"/developer/programmers-guide/consistency-guarantees","tags":[],"type":"text","url":"/developer/programmers-guide/consistency-guarantees","content":"Any updates that are seen by the client, through a read\nrequest or successful update, will never be rolled back when\nrecovering from server failures."},"1415":{"id":"/developer/programmers-guide/consistency-guarantees-8","page_id":"/developer/programmers-guide/consistency-guarantees","tags":[],"type":"text","url":"/developer/programmers-guide/consistency-guarantees","content":"*Timeliness* :\nThe clients view of the system is guaranteed to be up-to-date\nwithin a certain time bound (on the order of tens of seconds).\nEither system changes will be seen by a client within this bound, or\nthe client will detect a service outage."},"1416":{"id":"/developer/programmers-guide/consistency-guarantees-9","page_id":"/developer/programmers-guide/consistency-guarantees","tags":[],"type":"text","url":"/developer/programmers-guide/consistency-guarantees","content":"Using these consistency guarantees it is easy to build higher level\nfunctions such as leader election, barriers, queues, and read/write\nrevocable locks solely at the ZooKeeper client (no additions needed to\nZooKeeper). See Recipes and Solutions\nfor more details."},"1417":{"id":"/developer/programmers-guide/consistency-guarantees-10","page_id":"/developer/programmers-guide/consistency-guarantees","tags":[],"type":"text","url":"/developer/programmers-guide/consistency-guarantees","content":"Sometimes developers mistakenly assume one other guarantee that ZooKeeper does\n*not* in fact make. This is: *Simultaneously Consistent Cross-Client Views*:\nZooKeeper does not guarantee that at every instance in time, two different\nclients will have identical views of ZooKeeper data. Due to factors like\nnetwork delays, one client may perform an update before another client gets\nnotified of the change. Consider the scenario of two clients, A and B. If\nclient A sets the value of a znode /a from 0 to 1, then tells client B to read\n/a, client B may read the old value of 0, depending on which server it is\nconnected to. If it is important that Client A and Client B read the same\nvalue, Client B should call the &#x2A;*sync()** method from the ZooKeeper API\nmethod before it performs its read. So, ZooKeeper by itself doesn't guarantee\nthat changes occur synchronously across all servers, but ZooKeeper primitives\ncan be used to construct higher level functions that provide useful client\nsynchronization. (For more information, see the ZooKeeper\nRecipes)."},"1418":{"id":"/developer/programmers-guide/data-model","page_id":"/developer/programmers-guide/data-model","type":"page","content":"Data Model","breadcrumbs":["Multi-Page Documentation","Developer","Programmer's Guide"],"tags":[],"url":"/developer/programmers-guide/data-model"},"1419":{"id":"/developer/programmers-guide/data-model-0","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model","content":"Explains ZooKeeper's hierarchical namespace of znodes, including data access rules, ephemeral and sequence nodes, container nodes, TTL nodes, and the stat structure."},"1420":{"id":"/developer/programmers-guide/data-model-1","page_id":"/developer/programmers-guide/data-model","type":"heading","tags":[],"url":"/developer/programmers-guide/data-model#znodes","content":"ZNodes"},"1421":{"id":"/developer/programmers-guide/data-model-2","page_id":"/developer/programmers-guide/data-model","type":"heading","tags":[],"url":"/developer/programmers-guide/data-model#watches","content":"Watches"},"1422":{"id":"/developer/programmers-guide/data-model-3","page_id":"/developer/programmers-guide/data-model","type":"heading","tags":[],"url":"/developer/programmers-guide/data-model#data-access","content":"Data Access"},"1423":{"id":"/developer/programmers-guide/data-model-4","page_id":"/developer/programmers-guide/data-model","type":"heading","tags":[],"url":"/developer/programmers-guide/data-model#ephemeral-nodes","content":"Ephemeral Nodes"},"1424":{"id":"/developer/programmers-guide/data-model-5","page_id":"/developer/programmers-guide/data-model","type":"heading","tags":[],"url":"/developer/programmers-guide/data-model#getephemerals","content":"getEphemerals()"},"1425":{"id":"/developer/programmers-guide/data-model-6","page_id":"/developer/programmers-guide/data-model","type":"heading","tags":[],"url":"/developer/programmers-guide/data-model#sequence-nodes--unique-naming","content":"Sequence Nodes — Unique Naming"},"1426":{"id":"/developer/programmers-guide/data-model-7","page_id":"/developer/programmers-guide/data-model","type":"heading","tags":[],"url":"/developer/programmers-guide/data-model#container-nodes","content":"Container Nodes"},"1427":{"id":"/developer/programmers-guide/data-model-8","page_id":"/developer/programmers-guide/data-model","type":"heading","tags":[],"url":"/developer/programmers-guide/data-model#added-in-353","content":"Added in 3.5.3"},"1428":{"id":"/developer/programmers-guide/data-model-9","page_id":"/developer/programmers-guide/data-model","type":"heading","tags":[],"url":"/developer/programmers-guide/data-model#ttl-nodes","content":"TTL Nodes"},"1429":{"id":"/developer/programmers-guide/data-model-10","page_id":"/developer/programmers-guide/data-model","type":"heading","tags":[],"url":"/developer/programmers-guide/data-model#added-in-353-1","content":"Added in 3.5.3"},"1430":{"id":"/developer/programmers-guide/data-model-11","page_id":"/developer/programmers-guide/data-model","type":"heading","tags":[],"url":"/developer/programmers-guide/data-model#time-in-zookeeper","content":"Time in ZooKeeper"},"1431":{"id":"/developer/programmers-guide/data-model-12","page_id":"/developer/programmers-guide/data-model","type":"heading","tags":[],"url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"ZooKeeper Stat Structure"},"1432":{"id":"/developer/programmers-guide/data-model-13","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model","content":"ZooKeeper has a hierarchal namespace, much like a distributed file\nsystem. The only difference is that each node in the namespace can have\ndata associated with it as well as children. It is like having a file\nsystem that allows a file to also be a directory. Paths to nodes are\nalways expressed as canonical, absolute, slash-separated paths; there are\nno relative reference. Any unicode character can be used in a path subject\nto the following constraints:"},"1433":{"id":"/developer/programmers-guide/data-model-14","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model","content":"The null character (\\u0000) cannot be part of a path name. (This\ncauses problems with the C binding.)"},"1434":{"id":"/developer/programmers-guide/data-model-15","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model","content":"The following characters can't be used because they don't\ndisplay well, or render in confusing ways: \\u0001 - \\u001F and \\u007F"},"1435":{"id":"/developer/programmers-guide/data-model-16","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model","content":"\\u009F."},"1436":{"id":"/developer/programmers-guide/data-model-17","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model","content":"The following characters are not allowed: \\ud800 - uF8FF,\n\\uFFF0 - uFFFF."},"1437":{"id":"/developer/programmers-guide/data-model-18","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model","content":"The \".\" character can be used as part of another name, but \".\"\nand \"..\" cannot alone be used to indicate a node along a path,\nbecause ZooKeeper doesn't use relative paths. The following would be\ninvalid: \"/a/b/./c\" or \"/a/b/../c\"."},"1438":{"id":"/developer/programmers-guide/data-model-19","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model","content":"The token \"zookeeper\" is reserved."},"1439":{"id":"/developer/programmers-guide/data-model-20","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#znodes","content":"Every node in a ZooKeeper tree is referred to as a\n*znode*. Znodes maintain a stat structure that\nincludes version numbers for data changes, acl changes. The stat\nstructure also has timestamps. The version number, together with the\ntimestamp, allows ZooKeeper to validate the cache and to coordinate\nupdates. Each time a znode's data changes, the version number increases.\nFor instance, whenever a client retrieves data, it also receives the\nversion of the data. And when a client performs an update or a delete,\nit must supply the version of the data of the znode it is changing. If\nthe version it supplies doesn't match the actual version of the data,\nthe update will fail. (This behavior can be overridden.)"},"1440":{"id":"/developer/programmers-guide/data-model-21","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#znodes","content":"In distributed application engineering, the words *node* can refer to a\ngeneric host machine, a server, a member of an ensemble, a client process,\netc. In the ZooKeeper documentation, *znodes* refer to the data nodes.\n*Servers* refers to machines that make up the ZooKeeper service; *quorum\npeers* refer to the servers that make up an ensemble; client refers to any\nhost or process which uses a ZooKeeper service."},"1441":{"id":"/developer/programmers-guide/data-model-22","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#znodes","content":"Znodes are the main entity that a programmer access. They have\nseveral characteristics that are worth mentioning here."},"1442":{"id":"/developer/programmers-guide/data-model-23","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#watches","content":"Clients can set watches on znodes. Changes to that znode trigger\nthe watch and then clear the watch. When a watch triggers, ZooKeeper\nsends the client a notification. More information about watches can be\nfound in the section\nZooKeeper Watches."},"1443":{"id":"/developer/programmers-guide/data-model-24","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#data-access","content":"The data stored at each znode in a namespace is read and written\natomically. Reads get all the data bytes associated with a znode and a\nwrite replaces all the data. Each node has an Access Control List\n(ACL) that restricts who can do what."},"1444":{"id":"/developer/programmers-guide/data-model-25","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#data-access","content":"ZooKeeper was not designed to be a general database or large\nobject store. Instead, it manages coordination data. This data can\ncome in the form of configuration, status information, rendezvous, etc.\nA common property of the various forms of coordination data is that\nthey are relatively small: measured in kilobytes.\nThe ZooKeeper client and the server implementations have sanity checks\nto ensure that znodes have less than 1M of data, but the data should\nbe much less than that on average. Operating on relatively large data\nsizes will cause some operations to take much more time than others and\nwill affect the latencies of some operations because of the extra time\nneeded to move more data over the network and onto storage media. If\nlarge data storage is needed, the usual pattern of dealing with such\ndata is to store it on a bulk storage system, such as NFS or HDFS, and\nstore pointers to the storage locations in ZooKeeper."},"1445":{"id":"/developer/programmers-guide/data-model-26","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#ephemeral-nodes","content":"ZooKeeper also has the notion of ephemeral nodes. These znodes\nexists as long as the session that created the znode is active. When\nthe session ends the znode is deleted. Because of this behavior\nephemeral znodes are not allowed to have children. The list of ephemerals\nfor the session can be retrieved using &#x2A;*getEphemerals()** api."},"1446":{"id":"/developer/programmers-guide/data-model-27","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#getephemerals","content":"Retrieves the list of ephemeral nodes created by the session for the\ngiven path. If the path is empty, it will list all the ephemeral nodes\nfor the session.\n**Use Case** - A sample use case might be, if the list of ephemeral\nnodes for the session needs to be collected for duplicate data entry check\nand the nodes are created in a sequential manner so you do not know the name\nfor duplicate check. In that case, getEphemerals() api could be used to\nget the list of nodes for the session. This might be a typical use case\nfor service discovery."},"1447":{"id":"/developer/programmers-guide/data-model-28","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#sequence-nodes--unique-naming","content":"When creating a znode you can also request that\nZooKeeper append a monotonically increasing counter to the end\nof path. This counter is unique to the parent znode. The\ncounter has a format of %010d — that is 10 digits with 0\n(zero) padding (the counter is formatted in this way to\nsimplify sorting), i.e. \"`<path>0000000001`\". See\nQueue\nRecipe for an example use of this feature. Note: the\ncounter used to store the next sequence number is a signed int\n(4bytes) maintained by the parent node, the counter will\noverflow when incremented beyond 2147483647 (resulting in a\nname \"`<path>-2147483648`\")."},"1448":{"id":"/developer/programmers-guide/data-model-29","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#added-in-353","content":"ZooKeeper has the notion of container znodes. Container znodes are\nspecial purpose znodes useful for recipes such as leader, lock, etc.\nWhen the last child of a container is deleted, the container becomes\na candidate to be deleted by the server at some point in the future."},"1449":{"id":"/developer/programmers-guide/data-model-30","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#added-in-353","content":"Given this property, you should be prepared to get\nKeeperException.NoNodeException when creating children inside of\ncontainer znodes. i.e. when creating child znodes inside of container znodes\nalways check for KeeperException.NoNodeException and recreate the container\nznode when it occurs."},"1450":{"id":"/developer/programmers-guide/data-model-31","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#added-in-353-1","content":"When creating PERSISTENT or PERSISTENT\\_SEQUENTIAL znodes,\nyou can optionally set a TTL in milliseconds for the znode. If the znode\nis not modified within the TTL and has no children it will become a candidate\nto be deleted by the server at some point in the future."},"1451":{"id":"/developer/programmers-guide/data-model-32","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#added-in-353-1","content":"Note: TTL Nodes must be enabled via System property as they\nare disabled by default. See the Administrator's Guide for\ndetails. If you attempt to create TTL Nodes without the\nproper System property set the server will throw\nKeeperException.UnimplementedException."},"1452":{"id":"/developer/programmers-guide/data-model-33","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#time-in-zookeeper","content":"ZooKeeper tracks time multiple ways:"},"1453":{"id":"/developer/programmers-guide/data-model-34","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#time-in-zookeeper","content":"**Zxid**\nEvery change to the ZooKeeper state receives a stamp in the\nform of a *zxid* (ZooKeeper Transaction Id).\nThis exposes the total ordering of all changes to ZooKeeper. Each\nchange will have a unique zxid and if zxid1 is smaller than zxid2\nthen zxid1 happened before zxid2."},"1454":{"id":"/developer/programmers-guide/data-model-35","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#time-in-zookeeper","content":"**Version numbers**\nEvery change to a node will cause an increase to one of the\nversion numbers of that node. The three version numbers are version\n(number of changes to the data of a znode), cversion (number of\nchanges to the children of a znode), and aversion (number of changes\nto the ACL of a znode)."},"1455":{"id":"/developer/programmers-guide/data-model-36","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#time-in-zookeeper","content":"**Ticks**\nWhen using multi-server ZooKeeper, servers use ticks to define\ntiming of events such as status uploads, session timeouts,\nconnection timeouts between peers, etc. The tick time is only\nindirectly exposed through the minimum session timeout (2 times the\ntick time); if a client requests a session timeout less than the\nminimum session timeout, the server will tell the client that the\nsession timeout is actually the minimum session timeout."},"1456":{"id":"/developer/programmers-guide/data-model-37","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#time-in-zookeeper","content":"**Real time**\nZooKeeper doesn't use real time, or clock time, at all except\nto put timestamps into the stat structure on znode creation and\nznode modification."},"1457":{"id":"/developer/programmers-guide/data-model-38","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"The Stat structure for each znode in ZooKeeper is made up of the\nfollowing fields:"},"1458":{"id":"/developer/programmers-guide/data-model-39","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"**czxid**\nThe zxid of the change that caused this znode to be\ncreated."},"1459":{"id":"/developer/programmers-guide/data-model-40","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"**mzxid**\nThe zxid of the change that last modified this znode."},"1460":{"id":"/developer/programmers-guide/data-model-41","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"**pzxid**\nThe zxid of the change that last modified children of this znode."},"1461":{"id":"/developer/programmers-guide/data-model-42","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"**ctime**\nThe time in milliseconds from epoch when this znode was\ncreated."},"1462":{"id":"/developer/programmers-guide/data-model-43","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"**mtime**\nThe time in milliseconds from epoch when this znode was last\nmodified."},"1463":{"id":"/developer/programmers-guide/data-model-44","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"**version**\nThe number of changes to the data of this znode."},"1464":{"id":"/developer/programmers-guide/data-model-45","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"**cversion**\nThe number of changes to the children of this znode."},"1465":{"id":"/developer/programmers-guide/data-model-46","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"**aversion**\nThe number of changes to the ACL of this znode."},"1466":{"id":"/developer/programmers-guide/data-model-47","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"**ephemeralOwner**\nThe session id of the owner of this znode if the znode is an\nephemeral node. If it is not an ephemeral node, it will be\nzero."},"1467":{"id":"/developer/programmers-guide/data-model-48","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"**dataLength**\nThe length of the data field of this znode."},"1468":{"id":"/developer/programmers-guide/data-model-49","page_id":"/developer/programmers-guide/data-model","tags":[],"type":"text","url":"/developer/programmers-guide/data-model#zookeeper-stat-structure","content":"**numChildren**\nThe number of children of this znode."},"1469":{"id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","page_id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","type":"page","content":"Gotchas: Common Problems and Troubleshooting","breadcrumbs":["Multi-Page Documentation","Developer","Programmer's Guide"],"tags":[],"url":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting"},"1470":{"id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting-0","page_id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","tags":[],"type":"text","url":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","content":"Common pitfalls and troubleshooting tips for ZooKeeper application developers, covering watches, server failures, connection loss, performance, and recoverable errors."},"1471":{"id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting-1","page_id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","tags":[],"type":"text","url":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","content":"So now you know ZooKeeper. It's fast, simple, your application\nworks, but wait ... something's wrong. Here are some pitfalls that\nZooKeeper users fall into:"},"1472":{"id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting-2","page_id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","tags":[],"type":"text","url":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","content":"If you are using watches, you must look for the connected watch\nevent. When a ZooKeeper client disconnects from a server, you will\nnot receive notification of changes until reconnected. If you are\nwatching for a znode to come into existence, you will miss the event\nif the znode is created and deleted while you are disconnected."},"1473":{"id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting-3","page_id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","tags":[],"type":"text","url":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","content":"You must test ZooKeeper server failures. The ZooKeeper service\ncan survive failures as long as a majority of servers are active. The\nquestion to ask is: can your application handle it? In the real world\na client's connection to ZooKeeper can break. (ZooKeeper server\nfailures and network partitions are common reasons for connection\nloss.) The ZooKeeper client library takes care of recovering your\nconnection and letting you know what happened, but you must make sure\nthat you recover your state and any outstanding requests that failed.\nFind out if you got it right in the test lab, not in production - test\nwith a ZooKeeper service made up of a several of servers and subject\nthem to reboots."},"1474":{"id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting-4","page_id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","tags":[],"type":"text","url":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","content":"The list of ZooKeeper servers used by the client must match the\nlist of ZooKeeper servers that each ZooKeeper server has. Things can\nwork, although not optimally, if the client list is a subset of the\nreal list of ZooKeeper servers, but not if the client lists ZooKeeper\nservers not in the ZooKeeper cluster."},"1475":{"id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting-5","page_id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","tags":[],"type":"text","url":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","content":"Be careful where you put that transaction log. The most\nperformance-critical part of ZooKeeper is the transaction log.\nZooKeeper must sync transactions to media before it returns a\nresponse. A dedicated transaction log device is key to consistent good\nperformance. Putting the log on a busy device will adversely effect\nperformance. If you only have one storage device, put trace files on\nNFS and increase the snapshotCount; it doesn't eliminate the problem,\nbut it can mitigate it."},"1476":{"id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting-6","page_id":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","tags":[],"type":"text","url":"/developer/programmers-guide/gotchas-common-problems-and-troubleshooting","content":"Set your Java max heap size correctly. It is very important to\n&#x2A;avoid swapping.* Going to disk unnecessarily will\nalmost certainly degrade your performance unacceptably. Remember, in\nZooKeeper, everything is ordered, so if one request hits the disk, all\nother queued requests hit the disk.\nTo avoid swapping, try to set the heapsize to the amount of\nphysical memory you have, minus the amount needed by the OS and cache.\nThe best way to determine an optimal heap size for your configurations\nis to *run load tests*. If for some reason you\ncan't, be conservative in your estimates and choose a number well\nbelow the limit that would cause your machine to swap. For example, on\na 4G machine, a 3G heap is a conservative estimate to start\nwith."},"1477":{"id":"/developer/programmers-guide","page_id":"/developer/programmers-guide","type":"page","content":"Programmer's Guide","breadcrumbs":["Multi-Page Documentation","Developer","Programmer's Guide"],"tags":[],"url":"/developer/programmers-guide"},"1478":{"id":"/developer/programmers-guide-0","page_id":"/developer/programmers-guide","tags":[],"type":"text","url":"/developer/programmers-guide","content":"This document is a guide for developers wishing to create distributed applications that take advantage of ZooKeeper's coordination services. It contains conceptual and practical information."},"1479":{"id":"/developer/programmers-guide-1","page_id":"/developer/programmers-guide","type":"heading","tags":[],"url":"/developer/programmers-guide#links-to-other-information","content":"Links to Other Information"},"1480":{"id":"/developer/programmers-guide-2","page_id":"/developer/programmers-guide","tags":[],"type":"text","url":"/developer/programmers-guide","content":"The first four sections of this guide present a higher level\ndiscussions of various ZooKeeper concepts. These are necessary both for an\nunderstanding of how ZooKeeper works as well how to work with it. It does\nnot contain source code, but it does assume a familiarity with the\nproblems associated with distributed computing."},"1481":{"id":"/developer/programmers-guide-3","page_id":"/developer/programmers-guide","tags":[],"type":"text","url":"/developer/programmers-guide","content":"The next four sections provide practical programming\ninformation."},"1482":{"id":"/developer/programmers-guide-4","page_id":"/developer/programmers-guide","tags":[],"type":"text","url":"/developer/programmers-guide","content":"Most of the information in this document is written to be accessible as\nstand-alone reference material. However, before starting your first\nZooKeeper application, you should probably at least read the chapters on\nthe ZooKeeper Data Model and ZooKeeper Basic Operations."},"1483":{"id":"/developer/programmers-guide-5","page_id":"/developer/programmers-guide","tags":[],"type":"text","url":"/developer/programmers-guide#links-to-other-information","content":"Outside the formal documentation, there're several other sources of\ninformation for ZooKeeper developers."},"1484":{"id":"/developer/programmers-guide-6","page_id":"/developer/programmers-guide","tags":[],"type":"text","url":"/developer/programmers-guide#links-to-other-information","content":"*API Reference* :\nThe complete reference to the ZooKeeper API"},"1485":{"id":"/developer/programmers-guide-7","page_id":"/developer/programmers-guide","tags":[],"type":"text","url":"/developer/programmers-guide#links-to-other-information","content":"*ZooKeeper Talk at the Hadoop Summit 2008* :\nA video introduction to ZooKeeper, by Benjamin Reed of Yahoo!\nResearch"},"1486":{"id":"/developer/programmers-guide-8","page_id":"/developer/programmers-guide","tags":[],"type":"text","url":"/developer/programmers-guide#links-to-other-information","content":"*Barrier and Queue Tutorial* :\nThe excellent Java tutorial by Flavio Junqueira, implementing\nsimple barriers and producer-consumer queues using ZooKeeper."},"1487":{"id":"/developer/programmers-guide-9","page_id":"/developer/programmers-guide","tags":[],"type":"text","url":"/developer/programmers-guide#links-to-other-information","content":"*ZooKeeper - A Reliable, Scalable Distributed Coordination System* :\nAn article by Todd Hoff (07/15/2008)"},"1488":{"id":"/developer/programmers-guide-10","page_id":"/developer/programmers-guide","tags":[],"type":"text","url":"/developer/programmers-guide#links-to-other-information","content":"*ZooKeeper Recipes* :\nPseudo-level discussion of the implementation of various\nsynchronization solutions with ZooKeeper: Event Handles, Queues,\nLocks, and Two-phase Commits."},"1489":{"id":"/developer/programmers-guide/pluggable-authentication","page_id":"/developer/programmers-guide/pluggable-authentication","type":"page","content":"Pluggable Authentication","breadcrumbs":["Multi-Page Documentation","Developer","Programmer's Guide"],"tags":[],"url":"/developer/programmers-guide/pluggable-authentication"},"1490":{"id":"/developer/programmers-guide/pluggable-authentication-0","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"Describes ZooKeeper's pluggable authentication framework, how authentication plugins authenticate clients and match ACL entries, and how to add a custom scheme."},"1491":{"id":"/developer/programmers-guide/pluggable-authentication-1","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"ZooKeeper runs in a variety of different environments with\nvarious different authentication schemes, so it has a completely\npluggable authentication framework. Even the builtin authentication\nschemes use the pluggable authentication framework."},"1492":{"id":"/developer/programmers-guide/pluggable-authentication-2","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"To understand how the authentication framework works, first you must\nunderstand the two main authentication operations. The framework\nfirst must authenticate the client. This is usually done as soon as\nthe client connects to a server and consists of validating information\nsent from or gathered about a client and associating it with the connection.\nThe second operation handled by the framework is finding the entries in an\nACL that correspond to client. ACL entries are `<idspec, permissions>` pairs. The *idspec* may be\na simple string match against the authentication information associated\nwith the connection or it may be a expression that is evaluated against that\ninformation. It is up to the implementation of the authentication plugin\nto do the match. Here is the interface that an authentication plugin must\nimplement:"},"1493":{"id":"/developer/programmers-guide/pluggable-authentication-3","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"The first method *getScheme* returns the string\nthat identifies the plugin. Because we support multiple methods of authentication,\nan authentication credential or an *idspec* will always be\nprefixed with &#x2A;scheme:*. The ZooKeeper server uses the scheme\nreturned by the authentication plugin to determine which ids the scheme\napplies to."},"1494":{"id":"/developer/programmers-guide/pluggable-authentication-4","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"*handleAuthentication* is called when a client\nsends authentication information to be associated with a connection. The\nclient specifies the scheme to which the information corresponds. The\nZooKeeper server passes the information to the authentication plugin whose\n*getScheme* matches the scheme passed by the client. The\nimplementor of *handleAuthentication* will usually return\nan error if it determines that the information is bad, or it will associate information\nwith the connection using &#x2A;cnxn.getAuthInfo().add(new Id(getScheme(), data))*."},"1495":{"id":"/developer/programmers-guide/pluggable-authentication-5","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"The authentication plugin is involved in both setting and using ACLs. When an\nACL is set for a znode, the ZooKeeper server will pass the id part of the entry to\nthe &#x2A;isValid(String id)* method. It is up to the plugin to verify\nthat the id has a correct form. For example, *ip:172.16.0.0/16*\nis a valid id, but *ip:host.com* is not. If the new ACL includes\nan \"auth\" entry, *isAuthenticated* is used to see if the\nauthentication information for this scheme that is associated with the connection\nshould be added to the ACL. Some schemes\nshould not be included in auth. For example, the IP address of the client is not\nconsidered as an id that should be added to the ACL if auth is specified."},"1496":{"id":"/developer/programmers-guide/pluggable-authentication-6","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"ZooKeeper invokes &#x2A;matches(String id, String aclExpr)* when checking an ACL. It\nneeds to match authentication information of the client against the relevant ACL\nentries. To find the entries which apply to the client, the ZooKeeper server will\nfind the scheme of each entry and if there is authentication information\nfrom that client for that scheme, &#x2A;matches(String id, String aclExpr)*\nwill be called with *id* set to the authentication information\nthat was previously added to the connection by *handleAuthentication* and\n*aclExpr* set to the id of the ACL entry. The authentication plugin\nuses its own logic and matching scheme to determine if *id* is included\nin *aclExpr*."},"1497":{"id":"/developer/programmers-guide/pluggable-authentication-7","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"There are two built in authentication plugins: *ip* and\n*digest&#x2A;. Additional plugins can adding using system properties. At\nstartup the ZooKeeper server will look for system properties that start with\n\"zookeeper.authProvider.\" and interpret the value of those properties as the class name\nof an authentication plugin. These properties can be set using the\n*-Dzookeeper.authProvider.X=com.f.MyAuth* or adding entries such as\nthe following in the server configuration file:"},"1498":{"id":"/developer/programmers-guide/pluggable-authentication-8","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"Care should be taking to ensure that the suffix on the property is unique. If there are\nduplicates such as *-Dzookeeper.authProvider.X=com.f.MyAuth -Dzookeeper.authProvider.X=com.f.MyAuth2*,\nonly one will be used. Also all servers must have the same plugins defined, otherwise clients using\nthe authentication schemes provided by the plugins will have problems connecting to some servers."},"1499":{"id":"/developer/programmers-guide/pluggable-authentication-9","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"**Added in 3.6.0**: An alternate abstraction is available for pluggable\nauthentication. It provides additional arguments."},"1500":{"id":"/developer/programmers-guide/pluggable-authentication-10","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"Instead of implementing AuthenticationProvider you extend ServerAuthenticationProvider. Your handleAuthentication()\nand matches() methods will then receive the additional parameters (via ServerObjs and MatchValues)."},"1501":{"id":"/developer/programmers-guide/pluggable-authentication-11","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"**ZooKeeperServer**\nThe ZooKeeperServer instance"},"1502":{"id":"/developer/programmers-guide/pluggable-authentication-12","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"**ServerCnxn**\nThe current connection"},"1503":{"id":"/developer/programmers-guide/pluggable-authentication-13","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"**path**\nThe ZNode path being operated on (or null if not used)"},"1504":{"id":"/developer/programmers-guide/pluggable-authentication-14","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"**perm**\nThe operation value or 0"},"1505":{"id":"/developer/programmers-guide/pluggable-authentication-15","page_id":"/developer/programmers-guide/pluggable-authentication","tags":[],"type":"text","url":"/developer/programmers-guide/pluggable-authentication","content":"**setAcls**\nWhen the setAcl() method is being operated on, the list of ACLs that are being set"},"1506":{"id":"/developer/programmers-guide/sessions","page_id":"/developer/programmers-guide/sessions","type":"page","content":"Sessions","breadcrumbs":["Multi-Page Documentation","Developer","Programmer's Guide"],"tags":[],"url":"/developer/programmers-guide/sessions"},"1507":{"id":"/developer/programmers-guide/sessions-0","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"Covers ZooKeeper client sessions: connection states, session timeouts, expiration, password-based recovery, and how clients connect to a ZooKeeper ensemble."},"1508":{"id":"/developer/programmers-guide/sessions-1","page_id":"/developer/programmers-guide/sessions","type":"heading","tags":[],"url":"/developer/programmers-guide/sessions#qa-toc","content":"Q&A [!toc]"},"1509":{"id":"/developer/programmers-guide/sessions-2","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"A ZooKeeper client establishes a session with the ZooKeeper\nservice by creating a handle to the service using a language\nbinding. Once created, the handle starts off in the CONNECTING state\nand the client library tries to connect to one of the servers that\nmake up the ZooKeeper service at which point it switches to the\nCONNECTED state. During normal operation the client handle will be in one of these\ntwo states. If an unrecoverable error occurs, such as session\nexpiration or authentication failure, or if the application explicitly\ncloses the handle, the handle will move to the CLOSED state.\nThe following figure shows the possible state transitions of a\nZooKeeper client:"},"1510":{"id":"/developer/programmers-guide/sessions-3","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"To create a client session the application code must provide\na connection string containing a comma separated list of host:port pairs,\neach corresponding to a ZooKeeper server (e.g. \"127.0.0.1:4545\" or\n\"127.0.0.1:3000,127.0.0.1:3001,127.0.0.1:3002\"). The ZooKeeper\nclient library will pick an arbitrary server and try to connect to\nit. If this connection fails, or if the client becomes\ndisconnected from the server for any reason, the client will\nautomatically try the next server in the list, until a connection\nis (re-)established."},"1511":{"id":"/developer/programmers-guide/sessions-4","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"**Added in 3.2.0**: An\noptional \"chroot\" suffix may also be appended to the connection\nstring. This will run the client commands while interpreting all\npaths relative to this root (similar to the unix chroot\ncommand). If used the example would look like:\n\"127.0.0.1:4545/app/a\" or\n\"127.0.0.1:3000,127.0.0.1:3001,127.0.0.1:3002/app/a\" where the\nclient would be rooted at \"/app/a\" and all paths would be relative\nto this root - ie getting/setting/etc... \"/foo/bar\" would result\nin operations being run on \"/app/a/foo/bar\" (from the server\nperspective). This feature is particularly useful in multi-tenant\nenvironments where each user of a particular ZooKeeper service\ncould be rooted differently. This makes re-use much simpler as\neach user can code his/her application as if it were rooted at\n\"/\", while actual location (say /app/a) could be determined at\ndeployment time."},"1512":{"id":"/developer/programmers-guide/sessions-5","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"When a client gets a handle to the ZooKeeper service,\nZooKeeper creates a ZooKeeper session, represented as a 64-bit\nnumber, that it assigns to the client. If the client connects to a\ndifferent ZooKeeper server, it will send the session id as a part\nof the connection handshake. As a security measure, the server\ncreates a password for the session id that any ZooKeeper server\ncan validate.The password is sent to the client with the session\nid when the client establishes the session. The client sends this\npassword with the session id whenever it reestablishes the session\nwith a new server."},"1513":{"id":"/developer/programmers-guide/sessions-6","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"One of the parameters to the ZooKeeper client library call\nto create a ZooKeeper session is the session timeout in\nmilliseconds. The client sends a requested timeout, the server\nresponds with the timeout that it can give the client. The current\nimplementation requires that the timeout be a minimum of 2 times\nthe tickTime (as set in the server configuration) and a maximum of\n20 times the tickTime. The ZooKeeper client API allows access to\nthe negotiated timeout."},"1514":{"id":"/developer/programmers-guide/sessions-7","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"When a client (session) becomes partitioned from the ZK\nserving cluster it will begin searching the list of servers that\nwere specified during session creation. Eventually, when\nconnectivity between the client and at least one of the servers is\nre-established, the session will either again transition to the\n\"connected\" state (if reconnected within the session timeout\nvalue) or it will transition to the \"expired\" state (if\nreconnected after the session timeout). It is not advisable to\ncreate a new session object (a new ZooKeeper.class or zookeeper\nhandle in the c binding) for disconnection. The ZK client library\nwill handle reconnect for you. In particular we have heuristics\nbuilt into the client library to handle things like \"herd effect\",\netc... Only create a new session when you are notified of session\nexpiration (mandatory)."},"1515":{"id":"/developer/programmers-guide/sessions-8","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"Session expiration is managed by the ZooKeeper cluster\nitself, not by the client. When the ZK client establishes a\nsession with the cluster it provides a \"timeout\" value detailed\nabove. This value is used by the cluster to determine when the\nclient's session expires. Expirations happens when the cluster\ndoes not hear from the client within the specified session timeout\nperiod (i.e. no heartbeat). At session expiration the cluster will\ndelete any/all ephemeral nodes owned by that session and\nimmediately notify any/all connected clients of the change (anyone\nwatching those znodes). At this point the client of the expired\nsession is still disconnected from the cluster, it will not be\nnotified of the session expiration until/unless it is able to\nre-establish a connection to the cluster. The client will stay in\ndisconnected state until the TCP connection is re-established with\nthe cluster, at which point the watcher of the expired session\nwill receive the \"session expired\" notification."},"1516":{"id":"/developer/programmers-guide/sessions-9","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"Example state transitions for an expired session as seen by\nthe expired session's watcher:"},"1517":{"id":"/developer/programmers-guide/sessions-10","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"'connected' : session is established and client\nis communicating with cluster (client/server communication is\noperating properly)"},"1518":{"id":"/developer/programmers-guide/sessions-11","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":".... client is partitioned from the\ncluster"},"1519":{"id":"/developer/programmers-guide/sessions-12","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"'disconnected' : client has lost connectivity\nwith the cluster"},"1520":{"id":"/developer/programmers-guide/sessions-13","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":".... time elapses, after 'timeout' period the\ncluster expires the session, nothing is seen by client as it is\ndisconnected from cluster"},"1521":{"id":"/developer/programmers-guide/sessions-14","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":".... time elapses, the client regains network\nlevel connectivity with the cluster"},"1522":{"id":"/developer/programmers-guide/sessions-15","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"'expired' : eventually the client reconnects to\nthe cluster, it is then notified of the\nexpiration"},"1523":{"id":"/developer/programmers-guide/sessions-16","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"Another parameter to the ZooKeeper session establishment\ncall is the default watcher. Watchers are notified when any state\nchange occurs in the client. For example if the client loses\nconnectivity to the server the client will be notified, or if the\nclient's session expires, etc... This watcher should consider the\ninitial state to be disconnected (i.e. before any state changes\nevents are sent to the watcher by the client lib). In the case of\na new connection, the first event sent to the watcher is typically\nthe session connection event."},"1524":{"id":"/developer/programmers-guide/sessions-17","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"The session is kept alive by requests sent by the client. If\nthe session is idle for a period of time that would timeout the\nsession, the client will send a PING request to keep the session\nalive. This PING request not only allows the ZooKeeper server to\nknow that the client is still active, but it also allows the\nclient to verify that its connection to the ZooKeeper server is\nstill active. The timing of the PING is conservative enough to\nensure reasonable time to detect a dead connection and reconnect\nto a new server."},"1525":{"id":"/developer/programmers-guide/sessions-18","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"Once a connection to the server is successfully established\n(connected) there are basically two cases where the client lib generates\nconnectionloss (the result code in c binding, exception in Java — see\nthe API documentation for binding specific details) when either a synchronous or\nasynchronous operation is performed and one of the following holds:"},"1526":{"id":"/developer/programmers-guide/sessions-19","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"The application calls an operation on a session that is no\nlonger alive/valid"},"1527":{"id":"/developer/programmers-guide/sessions-20","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"The ZooKeeper client disconnects from a server when there\nare pending operations to that server, i.e., there is a pending asynchronous call."},"1528":{"id":"/developer/programmers-guide/sessions-21","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"**Added in 3.2.0 — SessionMovedException**. There is an internal\nexception that is generally not seen by clients called the SessionMovedException.\nThis exception occurs because a request was received on a connection for a session\nwhich has been reestablished on a different server. The normal cause of this error is\na client that sends a request to a server, but the network packet gets delayed, so\nthe client times out and connects to a new server. When the delayed packet arrives at\nthe first server, the old server detects that the session has moved, and closes the\nclient connection. Clients normally do not see this error since they do not read\nfrom those old connections. (Old connections are usually closed.) One situation in which this\ncondition can be seen is when two clients try to reestablish the same connection using\na saved session id and password. One of the clients will reestablish the connection\nand the second client will be disconnected (causing the pair to attempt to re-establish\nits connection/session indefinitely)."},"1529":{"id":"/developer/programmers-guide/sessions-22","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"**Updating the list of servers**. We allow a client to\nupdate the connection string by providing a new comma separated list of host:port pairs,\neach corresponding to a ZooKeeper server. The function invokes a probabilistic load-balancing\nalgorithm which may cause the client to disconnect from its current host with the goal\nto achieve expected uniform number of connections per server in the new list.\nIn case the current host to which the client is connected is not in the new list\nthis call will always cause the connection to be dropped. Otherwise, the decision\nis based on whether the number of servers has increased or decreased and by how much."},"1530":{"id":"/developer/programmers-guide/sessions-23","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"For example, if the previous connection string contained 3 hosts and now the list contains\nthese 3 hosts and 2 more hosts, 40% of clients connected to each of the 3 hosts will\nmove to one of the new hosts in order to balance the load. The algorithm will cause the client\nto drop its connection to the current host to which it is connected with probability 0.4 and in this\ncase cause the client to connect to one of the 2 new hosts, chosen at random."},"1531":{"id":"/developer/programmers-guide/sessions-24","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"Another example — suppose we have 5 hosts and now update the list to remove 2 of the hosts,\nthe clients connected to the 3 remaining hosts will stay connected, whereas all clients connected\nto the 2 removed hosts will need to move to one of the 3 hosts, chosen at random. If the connection\nis dropped, the client moves to a special mode where he chooses a new server to connect to using the\nprobabilistic algorithm, and not just round robin."},"1532":{"id":"/developer/programmers-guide/sessions-25","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"In the first example, each client decides to disconnect with probability 0.4 but once the decision is\nmade, it will try to connect to a random new server and only if it cannot connect to any of the new\nservers will it try to connect to the old ones. After finding a server, or trying all servers in the\nnew list and failing to connect, the client moves back to the normal mode of operation where it picks\nan arbitrary server from the connectString and attempts to connect to it. If that fails, it will continue\ntrying different random servers in round robin. (see above the algorithm used to initially choose a server)"},"1533":{"id":"/developer/programmers-guide/sessions-26","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"**Local session**. Added in 3.5.0, mainly implemented by ZOOKEEPER-1147."},"1534":{"id":"/developer/programmers-guide/sessions-27","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"Background: The creation and closing of sessions are costly in ZooKeeper because they need quorum confirmations,\nthey become the bottleneck of a ZooKeeper ensemble when it needs to handle thousands of client connections.\nSo after 3.5.0, we introduce a new type of session: local session which doesn't have a full functionality of a normal(global) session, this feature\nwill be available by turning on *localSessionsEnabled*."},"1535":{"id":"/developer/programmers-guide/sessions-28","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"when *localSessionsUpgradingEnabled* is disable:"},"1536":{"id":"/developer/programmers-guide/sessions-29","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"Local sessions cannot create ephemeral nodes"},"1537":{"id":"/developer/programmers-guide/sessions-30","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"Once a local session is lost, users cannot re-establish it using the session-id/password, the session and its watches are gone for good.\nNote: Losing the tcp connection does not necessarily imply that the session is lost. If the connection can be reestablished with the same zk server\nbefore the session timeout then the client can continue (it simply cannot move to another server)."},"1538":{"id":"/developer/programmers-guide/sessions-31","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"When a local session connects, the session info is only maintained on the zookeeper server that it is connected to. The leader is not aware of the creation of such a session and\nthere is no state written to disk."},"1539":{"id":"/developer/programmers-guide/sessions-32","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"The pings, expiration and other session state maintenance are handled by the server which current session is connected to."},"1540":{"id":"/developer/programmers-guide/sessions-33","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"when *localSessionsUpgradingEnabled* is enable:"},"1541":{"id":"/developer/programmers-guide/sessions-34","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"A local session can be upgraded to the global session automatically."},"1542":{"id":"/developer/programmers-guide/sessions-35","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"When a new session is created it is saved locally in a wrapped *LocalSessionTracker*. It can subsequently be upgraded\nto a global session as required (e.g. create ephemeral nodes). If an upgrade is requested the session is removed from local\ncollections while keeping the same session ID."},"1543":{"id":"/developer/programmers-guide/sessions-36","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"Currently, Only the operation: *create ephemeral node* needs a session upgrade from local to global.\nThe reason is that the creation of ephemeral node depends heavily on a global session. If local session can create ephemeral\nnode without upgrading to global session, it will cause the data inconsistency between different nodes.\nThe leader also needs to know about the lifespan of a session in order to clean up ephemeral nodes on close/expiry.\nThis requires a global session as the local session is tied to its particular server."},"1544":{"id":"/developer/programmers-guide/sessions-37","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"A session can be both a local and global session during upgrade, but the operation of upgrade cannot be called concurrently by two thread."},"1545":{"id":"/developer/programmers-guide/sessions-38","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions","content":"*ZooKeeperServer*(Standalone) uses *SessionTrackerImpl*; *LeaderZookeeper* uses *LeaderSessionTracker* which holds\n*SessionTrackerImpl*(global) and *LocalSessionTracker*(if enable); *FollowerZooKeeperServer* and *ObserverZooKeeperServer*\nuse *LearnerSessionTracker* which holds *LocalSessionTracker*.\nThe UML Graph of Classes about session:"},"1546":{"id":"/developer/programmers-guide/sessions-39","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions#qa-toc","content":"*What's the reason for having the config option to disable local session upgrade?*"},"1547":{"id":"/developer/programmers-guide/sessions-40","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions#qa-toc","content":"In a large deployment which wants to handle a very large number of clients, we know that clients connecting via the observers\nwhich is supposed to be local session only. So this is more like a safeguard against someone accidentally creates lots of ephemeral nodes and global sessions."},"1548":{"id":"/developer/programmers-guide/sessions-41","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions#qa-toc","content":"*When is the session created?*"},"1549":{"id":"/developer/programmers-guide/sessions-42","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions#qa-toc","content":"In the current implementation, it will try to create a local session when processing *ConnectRequest* and when\n*createSession* request reaches *FinalRequestProcessor*."},"1550":{"id":"/developer/programmers-guide/sessions-43","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions#qa-toc","content":"*What happens if the create for session is sent at server A and the client disconnects to some other server B\nwhich ends up sending it again and then disconnects and connects back to server A?*"},"1551":{"id":"/developer/programmers-guide/sessions-44","page_id":"/developer/programmers-guide/sessions","tags":[],"type":"text","url":"/developer/programmers-guide/sessions#qa-toc","content":"When a client reconnects to B, its sessionId won’t exist in B’s local session tracker. So B will send validation packet.\nIf CreateSession issued by A is committed before validation packet arrive the client will be able to connect.\nOtherwise, the client will get session expired because the quorum hasn’t know about this session yet.\nIf the client also tries to connect back to A again, the session is already removed from local session tracker.\nSo A will need to send a validation packet to the leader. The outcome should be the same as B depending on the timing of the request."},"1552":{"id":"/developer/programmers-guide/watches","page_id":"/developer/programmers-guide/watches","type":"page","content":"Watches","breadcrumbs":["Multi-Page Documentation","Developer","Programmer's Guide"],"tags":[],"url":"/developer/programmers-guide/watches"},"1553":{"id":"/developer/programmers-guide/watches-0","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches","content":"Describes ZooKeeper watches — one-time event triggers sent to clients when znode data or children change — including watch semantics, guarantees, and removal."},"1554":{"id":"/developer/programmers-guide/watches-1","page_id":"/developer/programmers-guide/watches","type":"heading","tags":[],"url":"/developer/programmers-guide/watches#semantics-of-watches","content":"Semantics of Watches"},"1555":{"id":"/developer/programmers-guide/watches-2","page_id":"/developer/programmers-guide/watches","type":"heading","tags":[],"url":"/developer/programmers-guide/watches#persistent-recursive-watches","content":"Persistent, Recursive Watches"},"1556":{"id":"/developer/programmers-guide/watches-3","page_id":"/developer/programmers-guide/watches","type":"heading","tags":[],"url":"/developer/programmers-guide/watches#remove-watches","content":"Remove Watches"},"1557":{"id":"/developer/programmers-guide/watches-4","page_id":"/developer/programmers-guide/watches","type":"heading","tags":[],"url":"/developer/programmers-guide/watches#what-zookeeper-guarantees-about-watches","content":"What ZooKeeper Guarantees about Watches"},"1558":{"id":"/developer/programmers-guide/watches-5","page_id":"/developer/programmers-guide/watches","type":"heading","tags":[],"url":"/developer/programmers-guide/watches#things-to-remember-about-watches","content":"Things to Remember about Watches"},"1559":{"id":"/developer/programmers-guide/watches-6","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches","content":"All of the read operations in ZooKeeper - &#x2A;*getData()**, &#x2A;*getChildren()**, and &#x2A;*exists()** - have the option of setting a watch as a\nside effect. Here is ZooKeeper's definition of a watch: a watch event is\none-time trigger, sent to the client that set the watch, which occurs when\nthe data for which the watch was set changes. There are three key points\nto consider in this definition of a watch:"},"1560":{"id":"/developer/programmers-guide/watches-7","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches","content":"**One-time trigger**\nOne watch event will be sent to the client when the data has changed.\nFor example, if a client does a getData(\"/znode1\", true) and later the\ndata for /znode1 is changed or deleted, the client will get a watch\nevent for /znode1. If /znode1 changes again, no watch event will be\nsent unless the client has done another read that sets a new\nwatch."},"1561":{"id":"/developer/programmers-guide/watches-8","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches","content":"**Sent to the client**\nThis implies that an event is on the way to the client, but may\nnot reach the client before the successful return code to the change\noperation reaches the client that initiated the change. Watches are\nsent asynchronously to watchers. ZooKeeper provides an ordering\nguarantee: a client will never see a change for which it has set a\nwatch until it first sees the watch event. Network delays or other\nfactors may cause different clients to see watches and return codes\nfrom updates at different times. The key point is that everything seen\nby the different clients will have a consistent order."},"1562":{"id":"/developer/programmers-guide/watches-9","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches","content":"**The data for which the watch was\nset**\nThis refers to the different ways a node can change. It\nhelps to think of ZooKeeper as maintaining two lists of\nwatches: data watches and child watches. getData() and\nexists() set data watches. getChildren() sets child\nwatches. Alternatively, it may help to think of watches being\nset according to the kind of data returned. getData() and\nexists() return information about the data of the node,\nwhereas getChildren() returns a list of children. Thus,\nsetData() will trigger data watches for the znode being set\n(assuming the set is successful). A successful create() will\ntrigger a data watch for the znode being created and a child\nwatch for the parent znode. A successful delete() will trigger\nboth a data watch and a child watch (since there can be no\nmore children) for a znode being deleted as well as a child\nwatch for the parent znode."},"1563":{"id":"/developer/programmers-guide/watches-10","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches","content":"Watches are maintained locally at the ZooKeeper server to which the\nclient is connected. This allows watches to be lightweight to set,\nmaintain, and dispatch. When a client connects to a new server, the watch\nwill be triggered for any session events. Watches will not be received\nwhile disconnected from a server. When a client reconnects, any previously\nregistered watches will be reregistered and triggered if needed. In\ngeneral this all occurs transparently. There is one case where a watch\nmay be missed: a watch for the existence of a znode not yet created will\nbe missed if the znode is created and deleted while disconnected."},"1564":{"id":"/developer/programmers-guide/watches-11","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches","content":"**New in 3.6.0:** Clients can also set\npermanent, recursive watches on a znode that are not removed when triggered\nand that trigger for changes on the registered znode as well as any children\nznodes recursively."},"1565":{"id":"/developer/programmers-guide/watches-12","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#semantics-of-watches","content":"We can set watches with the three calls that read the state of\nZooKeeper: exists, getData, and getChildren. The following list details\nthe events that a watch can trigger and the calls that enable them:"},"1566":{"id":"/developer/programmers-guide/watches-13","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#semantics-of-watches","content":"**Created event:**\nEnabled with a call to exists."},"1567":{"id":"/developer/programmers-guide/watches-14","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#semantics-of-watches","content":"**Deleted event:**\nEnabled with a call to exists, getData, and getChildren."},"1568":{"id":"/developer/programmers-guide/watches-15","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#semantics-of-watches","content":"**Changed event:**\nEnabled with a call to exists and getData."},"1569":{"id":"/developer/programmers-guide/watches-16","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#semantics-of-watches","content":"**Child event:**\nEnabled with a call to getChildren."},"1570":{"id":"/developer/programmers-guide/watches-17","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#persistent-recursive-watches","content":"**New in 3.6.0:** There is now a variation on the standard\nwatch described above whereby you can set a watch that does not get removed when triggered.\nAdditionally, these watches trigger the event types *NodeCreated*, *NodeDeleted*, and *NodeDataChanged*\nand, optionally, recursively for all znodes starting at the znode that the watch is registered for. Note\nthat *NodeChildrenChanged* events are not triggered for persistent recursive watches as it would be redundant."},"1571":{"id":"/developer/programmers-guide/watches-18","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#persistent-recursive-watches","content":"Persistent watches are set using the method &#x2A;addWatch()*. The triggering semantics and guarantees\n(other than one-time triggering) are the same as standard watches. The only exception regarding events is that\nrecursive persistent watchers never trigger child changed events as they are redundant.\nPersistent watches are removed using &#x2A;removeWatches()* with watcher type *WatcherType.Any*."},"1572":{"id":"/developer/programmers-guide/watches-19","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#remove-watches","content":"We can remove the watches registered on a znode with a call to\nremoveWatches. Also, a ZooKeeper client can remove watches locally even\nif there is no server connection by setting the local flag to true. The\nfollowing list details the events which will be triggered after the\nsuccessful watch removal."},"1573":{"id":"/developer/programmers-guide/watches-20","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#remove-watches","content":"**Child Remove event:**\nWatcher which was added with a call to getChildren."},"1574":{"id":"/developer/programmers-guide/watches-21","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#remove-watches","content":"**Data Remove event:**\nWatcher which was added with a call to exists or getData."},"1575":{"id":"/developer/programmers-guide/watches-22","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#remove-watches","content":"**Persistent Remove event:**\nWatcher which was added with a call to add a persistent watch."},"1576":{"id":"/developer/programmers-guide/watches-23","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#what-zookeeper-guarantees-about-watches","content":"With regard to watches, ZooKeeper maintains these\nguarantees:"},"1577":{"id":"/developer/programmers-guide/watches-24","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#what-zookeeper-guarantees-about-watches","content":"Watches are ordered with respect to other events, other\nwatches, and asynchronous replies. The ZooKeeper client libraries\nensures that everything is dispatched in order."},"1578":{"id":"/developer/programmers-guide/watches-25","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#what-zookeeper-guarantees-about-watches","content":"A client will see a watch event for a znode it is watching\nbefore seeing the new data that corresponds to that znode."},"1579":{"id":"/developer/programmers-guide/watches-26","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#what-zookeeper-guarantees-about-watches","content":"The order of watch events from ZooKeeper corresponds to the\norder of the updates as seen by the ZooKeeper service."},"1580":{"id":"/developer/programmers-guide/watches-27","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#things-to-remember-about-watches","content":"Standard watches are one time triggers; if you get a watch event and\nyou want to get notified of future changes, you must set another\nwatch."},"1581":{"id":"/developer/programmers-guide/watches-28","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#things-to-remember-about-watches","content":"Because standard watches are one time triggers and there is latency\nbetween getting the event and sending a new request to get a watch\nyou cannot reliably see every change that happens to a node in\nZooKeeper. Be prepared to handle the case where the znode changes\nmultiple times between getting the event and setting the watch\nagain. (You may not care, but at least realize it may\nhappen.)"},"1582":{"id":"/developer/programmers-guide/watches-29","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#things-to-remember-about-watches","content":"A watch object, or function/context pair, will only be\ntriggered once for a given notification. For example, if the same\nwatch object is registered for an exists and a getData call for the\nsame file and that file is then deleted, the watch object would\nonly be invoked once with the deletion notification for the file."},"1583":{"id":"/developer/programmers-guide/watches-30","page_id":"/developer/programmers-guide/watches","tags":[],"type":"text","url":"/developer/programmers-guide/watches#things-to-remember-about-watches","content":"When you disconnect from a server (for example, when the\nserver fails), you will not get any watches until the connection\nis reestablished. For this reason session events are sent to all\noutstanding watch handlers. Use session events to go into a safe\nmode: you will not be receiving events while disconnected, so your\nprocess should act conservatively in that mode."},"1584":{"id":"/developer/recipes","page_id":"/developer/recipes","type":"page","content":"Recipes and Solutions","breadcrumbs":["Multi-Page Documentation","Developer"],"tags":[],"url":"/developer/recipes"},"1585":{"id":"/developer/recipes-0","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes","content":"Guidelines for using ZooKeeper to implement higher-order constructs such as barriers, queues, locks, and leader election."},"1586":{"id":"/developer/recipes-1","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#a-guide-to-creating-higher-level-constructs-with-zookeeper","content":"A Guide to Creating Higher-level Constructs with ZooKeeper"},"1587":{"id":"/developer/recipes-2","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#important-note-about-error-handling","content":"Important Note About Error Handling"},"1588":{"id":"/developer/recipes-3","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#out-of-the-box-applications-name-service-configuration-group-membership","content":"Out of the Box Applications: Name Service, Configuration, Group Membership"},"1589":{"id":"/developer/recipes-4","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#barriers","content":"Barriers"},"1590":{"id":"/developer/recipes-5","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#double-barriers","content":"Double Barriers"},"1591":{"id":"/developer/recipes-6","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#queues","content":"Queues"},"1592":{"id":"/developer/recipes-7","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#priority-queues","content":"Priority Queues"},"1593":{"id":"/developer/recipes-8","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#locks","content":"Locks"},"1594":{"id":"/developer/recipes-9","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#recoverable-errors-and-the-guid","content":"Recoverable Errors and the GUID"},"1595":{"id":"/developer/recipes-10","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#shared-locks","content":"Shared Locks"},"1596":{"id":"/developer/recipes-11","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#revocable-shared-locks","content":"Revocable Shared Locks"},"1597":{"id":"/developer/recipes-12","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#two-phased-commit","content":"Two-phased Commit"},"1598":{"id":"/developer/recipes-13","page_id":"/developer/recipes","type":"heading","tags":[],"url":"/developer/recipes#leader-election","content":"Leader Election"},"1599":{"id":"/developer/recipes-14","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#a-guide-to-creating-higher-level-constructs-with-zookeeper","content":"In this article, you'll find guidelines for using\nZooKeeper to implement higher order functions. All of them are conventions\nimplemented at the client and do not require special support from\nZooKeeper. Hopefully the community will capture these conventions in client-side libraries\nto ease their use and to encourage standardization."},"1600":{"id":"/developer/recipes-15","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#a-guide-to-creating-higher-level-constructs-with-zookeeper","content":"One of the most interesting things about ZooKeeper is that even\nthough ZooKeeper uses *asynchronous* notifications, you\ncan use it to build *synchronous* consistency\nprimitives, such as queues and locks. As you will see, this is possible\nbecause ZooKeeper imposes an overall order on updates, and has mechanisms\nto expose this ordering."},"1601":{"id":"/developer/recipes-16","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#a-guide-to-creating-higher-level-constructs-with-zookeeper","content":"Note that the recipes below attempt to employ best practices. In\nparticular, they avoid polling, timers or anything else that would result\nin a \"herd effect\", causing bursts of traffic and limiting\nscalability."},"1602":{"id":"/developer/recipes-17","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#a-guide-to-creating-higher-level-constructs-with-zookeeper","content":"There are many useful functions that can be imagined that aren't\nincluded here - revocable read-write priority locks, as just one example.\nAnd some of the constructs mentioned here - locks, in particular -\nillustrate certain points, even though you may find other constructs, such\nas event handles or queues, a more practical means of performing the same\nfunction. In general, the examples in this section are designed to\nstimulate thought."},"1603":{"id":"/developer/recipes-18","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#important-note-about-error-handling","content":"When implementing the recipes you must handle recoverable exceptions\n(see the FAQ). In\nparticular, several of the recipes employ sequential ephemeral\nnodes. When creating a sequential ephemeral node there is an error case in\nwhich the create() succeeds on the server but the server crashes before\nreturning the name of the node to the client. When the client reconnects its\nsession is still valid and, thus, the node is not removed. The implication is\nthat it is difficult for the client to know if its node was created or not. The\nrecipes below include measures to handle this."},"1604":{"id":"/developer/recipes-19","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#out-of-the-box-applications-name-service-configuration-group-membership","content":"Name service and configuration are two of the primary applications\nof ZooKeeper. These two functions are provided directly by the ZooKeeper\nAPI."},"1605":{"id":"/developer/recipes-20","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#out-of-the-box-applications-name-service-configuration-group-membership","content":"Another function directly provided by ZooKeeper is *group\nmembership*. The group is represented by a node. Members of the\ngroup create ephemeral nodes under the group node. Nodes of the members\nthat fail abnormally will be removed automatically when ZooKeeper detects\nthe failure."},"1606":{"id":"/developer/recipes-21","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#barriers","content":"Distributed systems use *barriers*\nto block processing of a set of nodes until a condition is met\nat which time all the nodes are allowed to proceed. Barriers are\nimplemented in ZooKeeper by designating a barrier node. The\nbarrier is in place if the barrier node exists. Here's the\npseudo code:"},"1607":{"id":"/developer/recipes-22","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#barriers","content":"Client calls the ZooKeeper API's &#x2A;*exists()** function on the barrier node, with\n*watch* set to true."},"1608":{"id":"/developer/recipes-23","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#barriers","content":"If &#x2A;*exists()** returns false, the\nbarrier is gone and the client proceeds"},"1609":{"id":"/developer/recipes-24","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#barriers","content":"Else, if &#x2A;*exists()** returns true,\nthe clients wait for a watch event from ZooKeeper for the barrier\nnode."},"1610":{"id":"/developer/recipes-25","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#barriers","content":"When the watch event is triggered, the client reissues the\n&#x2A;*exists( )** call, again waiting until\nthe barrier node is removed."},"1611":{"id":"/developer/recipes-26","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"Double barriers enable clients to synchronize the beginning and\nthe end of a computation. When enough processes have joined the barrier,\nprocesses start their computation and leave the barrier once they have\nfinished. This recipe shows how to use a ZooKeeper node as a\nbarrier."},"1612":{"id":"/developer/recipes-27","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"The pseudo code in this recipe represents the barrier node as\n*b*. Every client process *p*\nregisters with the barrier node on entry and unregisters when it is\nready to leave. A node registers with the barrier node via the **Enter** procedure below, it waits until\n*x* client process register before proceeding with\nthe computation. (The *x* here is up to you to\ndetermine for your system.)"},"1613":{"id":"/developer/recipes-28","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"**Enter**"},"1614":{"id":"/developer/recipes-29","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"**Leave**"},"1615":{"id":"/developer/recipes-30","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"1. Create a name **n* = \\_b*+“/”+\\_p\\*\\*"},"1616":{"id":"/developer/recipes-31","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"1. &#x2A;*L = getChildren(b, false)**"},"1617":{"id":"/developer/recipes-32","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"2. Set watch: &#x2A;*exists(*b* + ‘‘/ready’’, true)**"},"1618":{"id":"/developer/recipes-33","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"2. if no children, exit"},"1619":{"id":"/developer/recipes-34","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"3. Create child: &#x2A;*create(*n*, EPHEMERAL)**"},"1620":{"id":"/developer/recipes-35","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"3. if *p* is only process node in L, delete(n) and exit"},"1621":{"id":"/developer/recipes-36","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"4. &#x2A;*L = getChildren(b, false)**"},"1622":{"id":"/developer/recipes-37","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"4. if *p* is the lowest process node in L, wait on highest process node in L"},"1623":{"id":"/developer/recipes-38","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"5. if fewer children in L than*x*, wait for watch event"},"1624":{"id":"/developer/recipes-39","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"5. else \\*\\*delete(*n*)\\*\\*if still exists and wait on lowest process node in L"},"1625":{"id":"/developer/recipes-40","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"6. else &#x2A;*create(b + ‘‘/ready’’, REGULAR)**"},"1626":{"id":"/developer/recipes-41","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"6. goto 1"},"1627":{"id":"/developer/recipes-42","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"On entering, all processes watch on a ready node and\ncreate an ephemeral node as a child of the barrier node. Each process\nbut the last enters the barrier and waits for the ready node to appear\nat line 5. The process that creates the xth node, the last process, will\nsee x nodes in the list of children and create the ready node, waking up\nthe other processes. Note that waiting processes wake up only when it is\ntime to exit, so waiting is efficient."},"1628":{"id":"/developer/recipes-43","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"On exit, you can't use a flag such as *ready*\nbecause you are watching for process nodes to go away. By using\nephemeral nodes, processes that fail after the barrier has been entered\ndo not prevent correct processes from finishing. When processes are\nready to leave, they need to delete their process nodes and wait for all\nother processes to do the same."},"1629":{"id":"/developer/recipes-44","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#double-barriers","content":"Processes exit when there are no process nodes left as children of\n*b*. However, as an efficiency, you can use the\nlowest process node as the ready flag. All other processes that are\nready to exit watch for the lowest existing process node to go away, and\nthe owner of the lowest process watches for any other process node\n(picking the highest for simplicity) to go away. This means that only a\nsingle process wakes up on each node deletion except for the last node,\nwhich wakes up everyone when it is removed."},"1630":{"id":"/developer/recipes-45","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#queues","content":"Distributed queues are a common data structure. To implement a\ndistributed queue in ZooKeeper, first designate a znode to hold the queue,\nthe queue node. The distributed clients put something into the queue by\ncalling create() with a pathname ending in \"queue-\", with the\n*sequence* and *ephemeral* flags in\nthe create() call set to true. Because the *sequence*\nflag is set, the new pathname will have the form\n*path-to-queue-node*/queue-X, where X is a monotonic increasing number. A\nclient that wants to be removed from the queue calls ZooKeeper's &#x2A;*getChildren( )** function, with\n*watch* set to true on the queue node, and begins\nprocessing nodes with the lowest number. The client does not need to issue\nanother &#x2A;*getChildren( )** until it exhausts\nthe list obtained from the first &#x2A;*getChildren(\n)** call. If there are no children in the queue node, the\nreader waits for a watch notification to check the queue again."},"1631":{"id":"/developer/recipes-46","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#queues","content":"There now exists a Queue implementation in ZooKeeper recipes directory. This\nis distributed with the release -- zookeeper-recipes/zookeeper-recipes-queue\ndirectory of the release artifact."},"1632":{"id":"/developer/recipes-47","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#priority-queues","content":"To implement a priority queue, you need only make two simple\nchanges to the generic queue\nrecipe . First, to add to a queue, the pathname ends with\n\"queue-YY\" where YY is the priority of the element with lower numbers\nrepresenting higher priority (just like UNIX). Second, when removing\nfrom the queue, a client uses an up-to-date children list meaning that\nthe client will invalidate previously obtained children lists if a watch\nnotification triggers for the queue node."},"1633":{"id":"/developer/recipes-48","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"Fully distributed locks that are globally synchronous, meaning at\nany snapshot in time no two clients think they hold the same lock. These\ncan be implemented using ZooKeeper. As with priority queues, first define\na lock node."},"1634":{"id":"/developer/recipes-49","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"There now exists a Lock implementation in ZooKeeper recipes directory. This is\ndistributed with the release -- zookeeper-recipes/zookeeper-recipes-lock\ndirectory of the release artifact."},"1635":{"id":"/developer/recipes-50","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"Clients wishing to obtain a lock do the following:"},"1636":{"id":"/developer/recipes-51","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"Call &#x2A;*create( )** with a pathname\nof \"*locknode*/guid-lock-\" and the *sequence* and\n*ephemeral* flags set. The *guid*\nis needed in case the create() result is missed. See the note below."},"1637":{"id":"/developer/recipes-52","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"Call &#x2A;*getChildren( )** on the lock\nnode *without* setting the watch flag (this is\nimportant to avoid the herd effect)."},"1638":{"id":"/developer/recipes-53","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"If the pathname created in step **1** has the lowest sequence number suffix, the\nclient has the lock and the client exits the protocol."},"1639":{"id":"/developer/recipes-54","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"The client calls &#x2A;*exists( )** with\nthe watch flag set on the path in the lock directory with the next\nlowest sequence number."},"1640":{"id":"/developer/recipes-55","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"if &#x2A;*exists( )** returns null, go\nto step **2**. Otherwise, wait for a\nnotification for the pathname from the previous step before going to\nstep **2**."},"1641":{"id":"/developer/recipes-56","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"The unlock protocol is very simple: clients wishing to release a\nlock simply delete the node they created in step 1."},"1642":{"id":"/developer/recipes-57","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"Here are a few things to notice:"},"1643":{"id":"/developer/recipes-58","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"The removal of a node will only cause one client to wake up\nsince each node is watched by exactly one client. In this way, you\navoid the herd effect."},"1644":{"id":"/developer/recipes-59","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"There is no polling or timeouts."},"1645":{"id":"/developer/recipes-60","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#locks","content":"Because of the way you implement locking, it is easy to see the\namount of lock contention, break locks, debug locking problems,\netc."},"1646":{"id":"/developer/recipes-61","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#recoverable-errors-and-the-guid","content":"If a recoverable error occurs calling &#x2A;*create()** the\nclient should call &#x2A;*getChildren()** and check for a node\ncontaining the *guid* used in the path name.\nThis handles the case (noted above) of\nthe create() succeeding on the server but the server crashing before returning the name\nof the new node."},"1647":{"id":"/developer/recipes-62","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"You can implement shared locks by with a few changes to the lock\nprotocol:"},"1648":{"id":"/developer/recipes-63","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"**Obtaining a read lock:**"},"1649":{"id":"/developer/recipes-64","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"**Obtaining a write lock:**"},"1650":{"id":"/developer/recipes-65","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"1. Call &#x2A;*create( )** to create a node with pathname \"&#x2A;guid-/read-*\". This is the lock node use later in the protocol. Make sure to set both the *sequence* and *ephemeral* flags."},"1651":{"id":"/developer/recipes-66","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"1. Call &#x2A;*create( )** to create a node with pathname \"&#x2A;guid-/write-*\". This is the lock node spoken of later in the protocol. Make sure to set both *sequence* and *ephemeral* flags."},"1652":{"id":"/developer/recipes-67","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"2. Call &#x2A;*getChildren( )** on the lock node *without* setting the *watch* flag - this is important, as it avoids the herd effect."},"1653":{"id":"/developer/recipes-68","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"2. Call &#x2A;*getChildren( )** on the lock node *without* setting the *watch* flag - this is important, as it avoids the herd effect."},"1654":{"id":"/developer/recipes-69","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"3. If there are no children with a pathname starting with \"&#x2A;write-*\" and having a lower sequence number than the node created in step **1**, the client has the lock and can exit the protocol."},"1655":{"id":"/developer/recipes-70","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"3. If there are no children with a lower sequence number than the node created in step **1**, the client has the lock and the client exits the protocol."},"1656":{"id":"/developer/recipes-71","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"4. Otherwise, call &#x2A;*exists( )**, with *watch* flag, set on the node in lock directory with pathname starting with \"&#x2A;write-*\" having the next lowest sequence number."},"1657":{"id":"/developer/recipes-72","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"4. Call &#x2A;*exists( ),** with *watch* flag set, on the node with the pathname that has the next lowest sequence number."},"1658":{"id":"/developer/recipes-73","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"5. If &#x2A;*exists( )** returns *false*, goto step **2**."},"1659":{"id":"/developer/recipes-74","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"5. If &#x2A;*exists( )** returns *false*, goto step **2**. Otherwise, wait for a notification for the pathname from the previous step before going to step **2**."},"1660":{"id":"/developer/recipes-75","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"6. Otherwise, wait for a notification for the pathname from the previous step before going to step **2**"},"1661":{"id":"/developer/recipes-76","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"Notes:"},"1662":{"id":"/developer/recipes-77","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"It might appear that this recipe creates a herd effect:\nwhen there is a large group of clients waiting for a read\nlock, and all getting notified more or less simultaneously\nwhen the \"&#x2A;write-*\" node with the lowest\nsequence number is deleted. In fact. that's valid behavior:\nas all those waiting reader clients should be released since\nthey have the lock. The herd effect refers to releasing a\n\"herd\" when in fact only a single or a small number of\nmachines can proceed."},"1663":{"id":"/developer/recipes-78","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#shared-locks","content":"See the note for Locks on how to use the guid in the node."},"1664":{"id":"/developer/recipes-79","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#revocable-shared-locks","content":"With minor modifications to the Shared Lock protocol, you make\nshared locks revocable by modifying the shared lock protocol:"},"1665":{"id":"/developer/recipes-80","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#revocable-shared-locks","content":"In step **1**, of both obtain reader\nand writer lock protocols, call &#x2A;*getData(\n)** with *watch* set, immediately after the\ncall to &#x2A;*create( )**. If the client\nsubsequently receives notification for the node it created in step\n**1**, it does another &#x2A;*getData( )** on that node, with\n*watch* set and looks for the string \"unlock\", which\nsignals to the client that it must release the lock. This is because,\naccording to this shared lock protocol, you can request the client with\nthe lock give up the lock by calling &#x2A;*setData()** on the lock node, writing \"unlock\" to that node."},"1666":{"id":"/developer/recipes-81","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#revocable-shared-locks","content":"Note that this protocol requires the lock holder to consent to\nreleasing the lock. Such consent is important, especially if the lock\nholder needs to do some processing before releasing the lock. Of course\nyou can always implement *Revocable Shared Locks with Freaking\nLaser Beams* by stipulating in your protocol that the revoker\nis allowed to delete the lock node if after some length of time the lock\nisn't deleted by the lock holder."},"1667":{"id":"/developer/recipes-82","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#two-phased-commit","content":"A two-phase commit protocol is an algorithm that lets all clients in\na distributed system agree either to commit a transaction or abort."},"1668":{"id":"/developer/recipes-83","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#two-phased-commit","content":"In ZooKeeper, you can implement a two-phased commit by having a\ncoordinator create a transaction node, say \"/app/Tx\", and one child node\nper participating site, say \"/app/Tx/s\\_i\". When coordinator creates the\nchild node, it leaves the content undefined. Once each site involved in\nthe transaction receives the transaction from the coordinator, the site\nreads each child node and sets a watch. Each site then processes the query\nand votes \"commit\" or \"abort\" by writing to its respective node. Once the\nwrite completes, the other sites are notified, and as soon as all sites\nhave all votes, they can decide either \"abort\" or \"commit\". Note that a\nnode can decide \"abort\" earlier if some site votes for \"abort\"."},"1669":{"id":"/developer/recipes-84","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#two-phased-commit","content":"An interesting aspect of this implementation is that the only role\nof the coordinator is to decide upon the group of sites, to create the\nZooKeeper nodes, and to propagate the transaction to the corresponding\nsites. In fact, even propagating the transaction can be done through\nZooKeeper by writing it in the transaction node."},"1670":{"id":"/developer/recipes-85","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#two-phased-commit","content":"There are two important drawbacks of the approach described above.\nOne is the message complexity, which is O(n²). The second is the\nimpossibility of detecting failures of sites through ephemeral nodes. To\ndetect the failure of a site using ephemeral nodes, it is necessary that\nthe site create the node."},"1671":{"id":"/developer/recipes-86","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#two-phased-commit","content":"To solve the first problem, you can have only the coordinator\nnotified of changes to the transaction nodes, and then notify the sites\nonce coordinator reaches a decision. Note that this approach is scalable,\nbut it is slower too, as it requires all communication to go through the\ncoordinator."},"1672":{"id":"/developer/recipes-87","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#two-phased-commit","content":"To address the second problem, you can have the coordinator\npropagate the transaction to the sites, and have each site creating its\nown ephemeral node."},"1673":{"id":"/developer/recipes-88","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"A simple way of doing leader election with ZooKeeper is to use the\n**SEQUENCE|EPHEMERAL** flags when creating\nznodes that represent \"proposals\" of clients. The idea is to have a znode,\nsay \"/election\", such that each znode creates a child znode \"/election/guid-n\\_\"\nwith both flags SEQUENCE|EPHEMERAL. With the sequence flag, ZooKeeper\nautomatically appends a sequence number that is greater than anyone\npreviously appended to a child of \"/election\". The process that created\nthe znode with the smallest appended sequence number is the leader."},"1674":{"id":"/developer/recipes-89","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"That's not all, though. It is important to watch for failures of the\nleader, so that a new client arises as the new leader in the case the\ncurrent leader fails. A trivial solution is to have all application\nprocesses watching upon the current smallest znode, and checking if they\nare the new leader when the smallest znode goes away (note that the\nsmallest znode will go away if the leader fails because the node is\nephemeral). But this causes a herd effect: upon a failure of the current\nleader, all other processes receive a notification, and execute\ngetChildren on \"/election\" to obtain the current list of children of\n\"/election\". If the number of clients is large, it causes a spike on the\nnumber of operations that ZooKeeper servers have to process. To avoid the\nherd effect, it is sufficient to watch for the next znode down on the\nsequence of znodes. If a client receives a notification that the znode it\nis watching is gone, then it becomes the new leader in the case that there\nis no smaller znode. Note that this avoids the herd effect by not having\nall clients watching the same znode."},"1675":{"id":"/developer/recipes-90","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"Here's the pseudo code:"},"1676":{"id":"/developer/recipes-91","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"Let ELECTION be a path of choice of the application. To volunteer to\nbe a leader:"},"1677":{"id":"/developer/recipes-92","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"Create znode z with path \"ELECTION/guid-n\\_\" with both SEQUENCE and\nEPHEMERAL flags;"},"1678":{"id":"/developer/recipes-93","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"Let C be the children of \"ELECTION\", and i is the sequence\nnumber of z;"},"1679":{"id":"/developer/recipes-94","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"Watch for changes on \"ELECTION/guid-n\\_j\", where j is the largest\nsequence number such that j \\< i and n\\_j is a znode in C;"},"1680":{"id":"/developer/recipes-95","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"Upon receiving a notification of znode deletion:"},"1681":{"id":"/developer/recipes-96","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"Let C be the new set of children of ELECTION;"},"1682":{"id":"/developer/recipes-97","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"If z is the smallest node in C, then execute leader\nprocedure;"},"1683":{"id":"/developer/recipes-98","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"Otherwise, watch for changes on \"ELECTION/guid-n\\_j\", where j is the\nlargest sequence number such that j \\< i and n\\_j is a znode in C;"},"1684":{"id":"/developer/recipes-99","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"Notes:"},"1685":{"id":"/developer/recipes-100","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"Note that the znode having no preceding znode on the list of\nchildren do not imply that the creator of this znode is aware that it is\nthe current leader. Applications may consider creating a separate znode\nto acknowledge that the leader has executed the leader procedure."},"1686":{"id":"/developer/recipes-101","page_id":"/developer/recipes","tags":[],"type":"text","url":"/developer/recipes#leader-election","content":"See the note for Locks on how to use the guid in the node."},"1687":{"id":"/developer/use-cases","page_id":"/developer/use-cases","type":"page","content":"Use Cases","breadcrumbs":["Multi-Page Documentation","Developer"],"tags":[],"url":"/developer/use-cases"},"1688":{"id":"/developer/use-cases-0","page_id":"/developer/use-cases","tags":[],"type":"text","url":"/developer/use-cases","content":"A catalog of real-world projects and organizations that use Apache ZooKeeper for distributed coordination."},"1689":{"id":"/developer/use-cases-1","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#free-software-projects","content":"Free Software Projects"},"1690":{"id":"/developer/use-cases-2","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#adroitlogic-ultraesb","content":"AdroitLogic UltraESB"},"1691":{"id":"/developer/use-cases-3","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#akka","content":"Akka"},"1692":{"id":"/developer/use-cases-4","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#eclipse-communication-framework","content":"Eclipse Communication Framework"},"1693":{"id":"/developer/use-cases-5","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#eclipse-gyrex","content":"Eclipse Gyrex"},"1694":{"id":"/developer/use-cases-6","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#goldenorb","content":"GoldenOrb"},"1695":{"id":"/developer/use-cases-7","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#juju","content":"Juju"},"1696":{"id":"/developer/use-cases-8","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#katta","content":"Katta"},"1697":{"id":"/developer/use-cases-9","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#keptcollections","content":"KeptCollections"},"1698":{"id":"/developer/use-cases-10","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#neo4j","content":"Neo4j"},"1699":{"id":"/developer/use-cases-11","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#norbert","content":"Norbert"},"1700":{"id":"/developer/use-cases-12","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#spring-cloud-zookeeper","content":"spring-cloud-zookeeper"},"1701":{"id":"/developer/use-cases-13","page_id":"/developer/use-cases","type":"heading","tags":[],"url":"/developer/use-cases#spring-statemachine","content":"spring-statemachine"},"1702":{"id":"/developer/use-cases-14","page_id":"/develo